<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Foros universitarios</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>
<link
    href="/css/global.css"
    rel="stylesheet"
>


</head>

<body>

    <!-- 1. Inyectar Navbar -->
    <%- include('partials/navbar') %>
    
    <main>
        <div class="container mt-5 mb-5">

            <!-- Cuadro exterior -->
            <div class="foro-fondo">

                <!-- Encabezado -->
                <div class="foro-encabezado">

                    <!-- Cuadro del título -->
                    <div class="foro-titulo">
                        <h1 class="mb-0">Foros</h1>
                    </div>

                    <!-- Filtro por carrera -->
                    <div class="foro-filtro">

                        <label for="filtroCarrera" class="form-label mb-1">
                            Filtrar por carrera
                        </label>

                        <select
                            id="filtroCarrera"
                            class="form-select"
                        >
                            <option value="todas">
                                Todas las carreras
                            </option>

                            <% carreras.forEach(carrera => { %>

                                <option value="<%= carrera.id_carrera_base %>">
                                    <%= carrera.nombre_carrera %>
                                </option>

                            <% }) %>

                        </select>

                    </div>

                </div>


                <p class="text-muted mt-4 mb-4">
                    Selecciona una universidad para buscar sus carreras y acceder a sus foros.
                </p>


                <!-- Lista de universidades -->
                <div class="universidades-lista">

                    <% universidades.forEach(universidad => { %>

                        <!-- Etiqueta de universidad -->
                        <div
                            class="universidad-item"
                            data-carreras="<%= universidad.carrerasIds.join(',') %>"
                        >

                            <!-- Logo y nombre -->
                            <div class="universidad-identidad">

                                <% if (universidad.logo_url) { %>

                                    <img
                                        src="<%= universidad.logo_url %>"
                                        alt="Logo de <%= universidad.nombre %>"
                                        class="universidad-logo"
                                    >

                                <% } else { %>

                                    <div class="universidad-logo logo-sin-imagen">
                                        <i class="bi bi-building"></i>
                                    </div>

                                <% } %>

                                <div class="universidad-nombre">

                                    <h4 class="mb-1">
                                        <%= universidad.nombre %>
                                    </h4>

                                    <% if (universidad.ciudad) { %>

                                        <span>
                                            <%= universidad.ciudad %>
                                        </span>

                                    <% } %>

                                </div>

                            </div>


                            <!-- Información -->
                            <div class="universidad-info">

                                <div>
                                    Carreras totales:
                                    <strong>
                                        <%= universidad.cantidadCarreras %>
                                    </strong>
                                </div>

                                <div class="mt-2">
                                    Carreras más populares:
                                </div>

                                <div class="carreras-populares">

                                    <% if (universidad.carrerasPopulares.length > 0) { %>

                                        <% universidad.carrerasPopulares.forEach((carrera, index) => { %>

                                            <div>
                                                <%= index + 1 %>.
                                                <%= carrera.nombre_carrera %>
                                            </div>

                                        <% }) %>

                                    <% } else { %>

                                        <div>
                                            No hay carreras registradas
                                        </div>

                                    <% } %>

                                </div>

                            </div>


                            <!-- Botón -->
                            <div class="universidad-boton">

                                <a
                                    href="/foros/<%= universidad.id_universidad %>"
                                    class="btn btn-color-base"
                                >
                                    Ver carreras
                                </a>

                            </div>

                        </div>

                    <% }) %>

                </div>

            </div>

        </div>
    </main>

    <!-- Inyectar Footer -->
    <%- include('partials/footer') %>

    <script>
        const filtroCarrera = document.getElementById('filtroCarrera');
        const universidades = document.querySelectorAll('.universidad-item');

        filtroCarrera.addEventListener('change', function () {

            const carreraSeleccionada = this.value;

            universidades.forEach(universidad => {

                const carreras = universidad.dataset.carreras
                    .split(',')
                    .filter(carrera => carrera !== '');

                if (carreraSeleccionada === 'todas') {

                    universidad.style.display = 'flex';

                    return;
                }

                if (carreras.includes(carreraSeleccionada)) {

                    universidad.style.display = 'flex';

                } else {

                    universidad.style.display = 'none';

                }

            });

        });

    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
