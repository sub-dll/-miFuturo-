<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Foros universitarios</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

</head>

<body>

<style>
    .btn-color-base {
        background-color: #8C9FBA;
        border-color: #8C9FBA;
        color: white;
    }
        
    .foro-fondo {
        background-color: #D3DCE5;
        border-radius: 25px;
        padding: 25px;
    }

    .foro-contenido {
        background-color: white;
        border-radius: 18px;
        padding: 30px;
    }

    </style>

    <!-- 1. Inyectar Navbar -->
    <%- include('partials/navbar') %>
    
    <main>
        <div class="container mt-5 mb-5">

            <!-- Cuadro exterior -->
            <div class="foro-fondo">

                <!-- Cuadro interior -->
                <div class="foro-contenido">


            <h1 class="mb-2">Foros universitarios</h1>

            <p class="text-muted mb-4">
                Selecciona una universidad para buscar sus carreras y acceder a sus foros.
            </p>

            <div class="row">

                <% universidades.forEach(universidad => { %>

                    <div class="col-md-6 col-lg-4 mb-4">

                        <div class="card h-100">

                            <div class="card-body">

                                <h5 class="card-title">
                                    <%= universidad.nombre %>
                                </h5>

                                <p class="card-text">
                                    <strong>
                                        <%= universidad.cantidadCarreras %>
                                    </strong>
                                    Carreras disponibles
                                </p>

                                <a
                                    href="/foros/universidad/<%= universidad.id_universidad %>"
                                    class="btn btn-color-base"
                                >
                                    Ver carreras
                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

                </div>
            </div>
        </div>
    </main>

    <!-- Inyectar Footer -->
    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
