<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Foros universitarios</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">
<link
    href="/css/global.css"
    rel="stylesheet">


</head>

<body>

    <!-- Inyectar Navbar -->
    <%- include('partials/navbar') %>
    
    <main>
        <div class="container mt-5 mb-5">

            <!-- Cuadro exterior -->
            <div class="foro-fondo">

                <!-- Encabezado -->
                <div class="foro-encabezado">

                    <!-- Titulo -->
                    <div class="foro-titulo">
                        <h1 class="mb-0">Foros</h1>
                    </div>
                                        
                    <!-- Filtros de universidades -->
                    <div class="foro-filtro">

                        <form action="/foros" method="GET" class="row g-3 align-items-end">

                            <!-- Nombre de universidad -->
                            <div class="col-md-4">
                                <label for="filtroNombre" class="form-label">
                                    Buscar universidad
                                </label>

                                <input
                                    type="text"
                                    id="filtroNombre"
                                    name="nombre"
                                    class="form-control"
                                    placeholder="Nombre de universidad..."
                                    value="<%= nombreBusqueda || '' %>"
                                >
                            </div>

                            <!-- Ciudad -->
                            <div class="col-md-3">
                                <label for="filtroCiudad" class="form-label">
                                    Ciudad
                                </label>

                                <select
                                    id="filtroCiudad"
                                    name="ciudad"
                                    class="form-select"
                                >
                                    <option value="">Todas las ciudades</option>

                                    <% ciudades.forEach(ciudad => { %>
                                        <option
                                            value="<%= ciudad %>"
                                            <%= ciudadSeleccionada === ciudad ? 'selected' : '' %>
                                        >
                                            <%= ciudad %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Carrera -->
                            <div class="col-md-3">
                                <label for="filtroCarrera" class="form-label">
                                    Carrera
                                </label>

                                <select
                                    id="filtroCarrera"
                                    name="carrera"
                                    class="form-select"
                                >
                                    <option value="">Todas las carreras</option>

                                    <% carreras.forEach(carrera => { %>
                                        <option
                                            value="<%= carrera.id_carrera_base %>"
                                            <%= Number(carreraSeleccionada) === Number(carrera.id_carrera_base) ? 'selected' : '' %>
                                        >
                                            <%= carrera.nombre_carrera %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <!-- Acciones -->
                            <div class="col-md-2 d-flex gap-2">
                                <button type="submit" class="btn btn-color-base">
                                    Buscar
                                </button>

                                <a href="/foros" class="btn btn-outline-secondary">
                                    Limpiar
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Lista de universidades -->
                <div class="universidades-lista">

                    <% if (universidades.length > 0) { %>

                        <% universidades.forEach(universidad => { %>

                        <!-- Etiqueta de universidad -->
                        <div
                            class="universidad-item"
                            data-carreras="<%= universidad.carrerasIds.join(',') %>"
                        >

                            <!-- Logo y nombre -->
                            <div class="universidad-identidad">

                                <% if (universidad.logo_url) { %>

                                    <img
                                        src="<%= universidad.logo_url %>"
                                        alt="Logo de <%= universidad.nombre %>"
                                        class="universidad-logo"
                                    >

                                <% } else { %>

                                    <div class="universidad-logo logo-sin-imagen">
                                        <i class="bi bi-building"></i>
                                    </div>

                                <% } %>

                                <div class="universidad-nombre">

                                    <h4 class="mb-1">
                                        <%= universidad.nombre %>
                                    </h4>

                                    <% if (universidad.ciudad) { %>

                                        <span>
                                            <%= universidad.ciudad %>
                                        </span>

                                    <% } %>

                                </div>

                            </div>


                            <!-- Info -->
                            <div class="universidad-info">

                                <div>
                                    Carreras totales:
                                    <strong>
                                        <%= universidad.cantidadCarreras %>
                                    </strong>
                                </div>

                                <div class="mt-2">
                                    Carreras más populares:
                                </div>

                                <div class="carreras-populares">

                                    <% if (universidad.carrerasPopulares.length > 0) { %>

                                        <% universidad.carrerasPopulares.forEach((carrera, index) => { %>

                                            <div>
                                                <%= index + 1 %>.
                                                <%= carrera.nombre_carrera %>
                                            </div>

                                        <% }) %>

                                    <% } else { %>

                                        <div>
                                            No hay carreras registradas
                                        </div>

                                    <% } %>

                                </div>

                            </div>

                            <div class="universidad-boton">

                                <a
                                    href="/foros/<%= universidad.id_universidad %>"
                                    class="btn btn-color-base"
                                >
                                    Ver carreras
                                </a>
                            </div>
                        </div>
                        <% }) %>

                    <% } else { %>

                        <div class="text-center py-5">
                            <h5>No se encontraron universidades</h5>

                            <p class="text-muted mb-0">
                                No hay universidades que ofrezcan la carrera seleccionada.
                            </p>
                        </div>

                    <% } %>
                </div>

                <!-- Paginación -->
                <% if (totalPaginas > 1) { %>

                    <nav class="mt-4" aria-label="Paginación de universidades">
                        <ul class="pagination justify-content-center mb-0">

                            <!-- Anterior -->
                            <li class="page-item <%= paginaActual <= 1 ? 'disabled' : '' %>">

                                <a
                                    class="page-link"
                                    href="/foros?pagina=<%= paginaActual + 1 %>&carrera=<%= carreraSeleccionada || '' 
                                    %>&nombre=<%= encodeURIComponent(nombreBusqueda || '') 
                                    %>&ciudad=<%= encodeURIComponent(ciudadSeleccionada || '') %>"
                                >
                                    Anterior
                                </a>
                            </li>

                            <!-- Página actual -->
                            <li class="page-item disabled">

                                <span class="page-link">
                                    Página <%= paginaActual %> de <%= totalPaginas %>
                                </span>
                            </li>

                            <!-- Siguiente -->
                            <li class="page-item <%= paginaActual >= totalPaginas ? 'disabled' : '' %>">
                                <a
                                    class="page-link"
                                    href="/foros?pagina=<%= paginaActual + 1 %>&carrera=<%= carreraSeleccionada || '' %>"
                                >
                                    Siguiente
                                </a>
                            </li>
                        </ul>
                    </nav>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Inyectar Footer -->
    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
