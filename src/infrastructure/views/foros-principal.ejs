<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Foros universitarios</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

</head>

<body>

<div class="container mt-5">

    <h1 class="mb-2">Foros universitarios</h1>

    <p class="text-muted mb-4">
        Selecciona una universidad para buscar sus carreras y acceder a sus foros.
    </p>

    <div class="row">

        <% universidades.forEach(universidad => { %>

            <div class="col-md-6 col-lg-4 mb-4">

                <div class="card h-100">

                    <div class="card-body">

                        <h5 class="card-title">
                            <%= universidad.nombre %>
                        </h5>

                        <p class="card-text">
                            <strong>
                                <%= universidad.cantidadCarreras %>
                            </strong>
                            carreras disponibles
                        </p>

                        <a
                            href="/foros/universidad/<%= universidad.id_universidad %>"
                            class="btn btn-primary"
                        >
                            Ver carreras
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>
