<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hilos del foro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<style>
    .btn-color-base {
        background-color: #8C9FBA;
        border-color: #8C9FBA;
        color: white;
    }
    
    .foro-fondo {
        background-color: #D3DCE5;
        border-radius: 25px;
        padding: 25px;
    }

    .foro-contenido {
        background-color: white;
        border-radius: 18px;
        padding: 30px;
    }

    </style>

    <main>

    <!-- 1. Inyectar Navbar -->
    <%- include('partials/navbar') %>

    <main>
        <div class="container mt-5 mb-5">

            <!-- Cuadro exterior -->
            <div class="foro-fondo">

                <!-- Cuadro interior -->
                <div class="foro-contenido">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h1>
                        <%= tituloForo %>
                    </h1>

                    <p class="text-muted">
                        Hilos y preguntas de este foro
                    </p>
                </div>

                <a href="/foros" class="btn btn-outline-secondary">
                    Volver
                </a>

            </div>


            <!-- Buscador y botón para nuevo hilo -->
            <div class="d-flex gap-2 mb-4">

                <form action="" method="GET" class="flex-grow-1">

                    <div class="input-group">

                        <input
                            type="text"
                            name="buscar"
                            class="form-control"
                            placeholder="Buscar en los hilos..."
                            value="<%= buscar || '' %>"
                        >

                        <button type="submit" class="btn btn-color-base">
                            Buscar
                        </button>

                    </div>

                </form>

                <button
                    type="button"
                    class="btn btn-color-base"
                    data-bs-toggle="modal"
                    data-bs-target="#nuevoHiloModal"
                >
                    + Nuevo hilo
                </button>
                <!-- Modal Nuevo Hilo -->
                <div
                    class="modal fade"
                    id="nuevoHiloModal"
                    tabindex="-1"
                    aria-labelledby="nuevoHiloModalLabel"
                    aria-hidden="true"
                >
                    <div class="modal-dialog modal-dialog-centered">

                        <div class="modal-content">

                            <div class="modal-header">

                                <h5 class="modal-title" id="nuevoHiloModalLabel">
                                    Crear nuevo hilo
                                </h5>

                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Cerrar"
                                ></button>

                            </div>

                            <form
                                action="/foros/nuevo-hilo"
                                method="POST"
                            >

                                <div class="modal-body">

                                    <div class="mb-3">

                                        <label for="titulo" class="form-label">
                                            Título
                                        </label>

                                        <input
                                            type="text"
                                            class="form-control"
                                            id="titulo"
                                            name="titulo"
                                            placeholder="Escribe el título del hilo..."
                                            required
                                        >

                                    </div>


                                    <div class="mb-3">

                                        <label for="contenido" class="form-label">
                                            Contenido
                                        </label>

                                        <textarea
                                            class="form-control"
                                            id="contenido"
                                            name="contenido"
                                            rows="6"
                                            placeholder="Escribe aquí tu pregunta o comentario..."
                                            required
                                        ></textarea>

                                    </div>

                                </div>


                                <div class="modal-footer">

                                    <button
                                        type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal"
                                    >
                                        Cancelar
                                    </button>

                                    <button
                                        type="submit"
                                        class="btn btn-color-base"
                                    >
                                        Publicar hilo
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>
                </div>
            </div>


            <div class="d-flex justify-content-between align-items-center mb-3">

                <!-- Titulo -->
                <h3 class="mb-0">
                    Hilos
                </h3>

                <!-- Filtro por programa -->
                <select
                    class="form-select"
                    style="width: 280px;"
                    id="filtroPrograma"
                    name="programa"
                >
                    <option value="">
                        Todos los programas
                    </option>

                    <% programas.forEach(programa => { %>

                        <option value="<%= programa.id_programa %>">
                            <%= programa.nombre_carrera %>
                        </option>

                    <% }) %>

                </select>

            </div>


            <!-- Lista de hilos -->
            <div class="list-group">

                <% hilos.forEach(hilo => { %>

                    <a
                        href="/foros/hilo/<%= hilo.id_hilo %>"
                        class="list-group-item list-group-item-action"
                    >

                        <div class="d-flex justify-content-between align-items-start">

                            <!-- Información principal -->
                            <div class="me-3">

                                <h5 class="mb-1">
                                    <%= hilo.titulo %>
                                </h5>

                                <p class="mb-1 text-muted">
                                    <%= hilo.descripcion %>
                                </p>

                                <small class="text-muted">
                                    Publicado por: <%= hilo.usuario %>
                                </small>

                            </div>


                            <!-- Información secundaria -->
                            <div class="text-end">

                                <!-- Likes -->
                                <small class="text-muted d-block">
                                    👍 <%= hilo.likes || 0 %> likes
                                </small>

                                <!-- Respuestas -->
                                <small class="text-muted d-block">
                                    💬 <%= hilo.respuestas || 0 %> respuestas
                                </small>

                                <!-- Fecha -->
                                <small class="text-muted">
                                    <%= hilo.fecha %>
                                </small>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>


            <!-- Sin hilos -->
            <% if (hilos.length === 0) { %>

                <div class="alert alert-warning mt-3">
                    No hay hilos disponibles en este foro.
                </div>
            <% } %>
                </div>
            </div>
        </div>


    </main>

    <!-- Inyectar Footer -->
    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>