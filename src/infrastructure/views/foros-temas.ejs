<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hilos del foro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container mt-5">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h1>
                    <%= tituloForo %>
                </h1>

                <p class="text-muted">
                    Hilos y preguntas de este foro
                </p>
            </div>

            <a href="/foros" class="btn btn-outline-secondary">
                Volver
            </a>

        </div>


        <!-- Buscador y botón para nuevo hilo -->
        <div class="d-flex gap-2 mb-4">

            <form action="" method="GET" class="flex-grow-1">

                <div class="input-group">

                    <input
                        type="text"
                        name="buscar"
                        class="form-control"
                        placeholder="Buscar en los hilos..."
                        value="<%= buscar || '' %>"
                    >

                    <button type="submit" class="btn btn-primary">
                        Buscar
                    </button>

                </div>

            </form>

            <a href="/foros/nuevo-hilo" class="btn btn-success">
                + Nuevo hilo
            </a>

        </div>


        <!-- Titulo -->
        <h3 class="mb-3">
            Hilos
        </h3>


        <!-- Lista de hilos -->
        <div class="list-group">

            <% hilos.forEach(hilo => { %>

                <a
                    href="/foros/hilo/<%= hilo.id_hilo %>"
                    class="list-group-item list-group-item-action"
                >

                    <div class="d-flex justify-content-between align-items-start">

                        <!-- Información principal -->
                        <div class="me-3">

                            <h5 class="mb-1">
                                <%= hilo.titulo %>
                            </h5>

                            <p class="mb-1 text-muted">
                                <%= hilo.descripcion %>
                            </p>

                            <small class="text-muted">
                                Publicado por: <%= hilo.usuario %>
                            </small>

                        </div>


                        <!-- Información secundaria -->
                        <div class="text-end">

                            <!-- Likes -->
                            <small class="text-muted d-block">
                                👍 <%= hilo.likes || 0 %> likes
                            </small>

                            <!-- Respuestas -->
                            <small class="text-muted d-block">
                                💬 <%= hilo.respuestas || 0 %> respuestas
                            </small>

                            <!-- Fecha -->
                            <small class="text-muted">
                                <%= hilo.fecha %>
                            </small>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>


        <!-- Sin hilos -->
        <% if (hilos.length === 0) { %>

            <div class="alert alert-info mt-3">
                No hay hilos disponibles en este foro.
            </div>
        <% } %>

    </div>

</body>

</html>