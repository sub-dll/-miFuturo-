<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hilos del foro</title>

    <link 
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
    rel="stylesheet"
    >

    <link
    href="/css/global.css"
    rel="stylesheet"
    >

</head>

<body>

    <main>

    <!-- 1. Inyectar Navbar -->
    <%- include('partials/navbar') %>

    <main>
        <div class="container mt-5 mb-5">

            <!-- Cuadro exterior -->
            <div class="foro-fondo">

                <!-- Cuadro interior -->
                <div class="foro-contenido">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h1>
                        <%= tituloForo %>
                    </h1>

                    <p class="text-muted">
                        Hilos y preguntas de este foro
                    </p>
                </div>

                <a href="/foros" class="btn btn-outline-secondary">
                    Volver
                </a>

            </div>


            <!-- Buscador y botón para nuevo hilo -->
            <div class="d-flex gap-2 mb-4">

                <form action="" method="GET" class="flex-grow-1">

                    <div class="input-group">

                        <input
                            type="text"
                            name="buscar"
                            class="form-control"
                            placeholder="Buscar en los hilos..."
                            value="<%= buscar || '' %>"
                        >

                        <button type="submit" class="btn btn-color-base">
                            Buscar
                        </button>

                    </div>

                </form>

                <button
                    type="button"
                    class="btn btn-color-base"
                    data-bs-toggle="modal"
                    data-bs-target="#nuevoHiloModal"
                >
                    + Nuevo hilo
                </button>
                <!-- Modal Nuevo Hilo -->
                <div
                    class="modal fade"
                    id="nuevoHiloModal"
                    tabindex="-1"
                    aria-labelledby="nuevoHiloModalLabel"
                    aria-hidden="true"
                >
                    <div class="modal-dialog modal-dialog-centered">

                        <div class="modal-content">

                            <div class="modal-header">

                                <h5 class="modal-title" id="nuevoHiloModalLabel">
                                    Crear nuevo hilo
                                </h5>

                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Cerrar"
                                ></button>

                            </div>

                            <form
                                action="/foros/nuevo-hilo"
                                method="POST"
                            >

                                <div class="modal-body">

                                    <div class="mb-3">

                                        <label for="titulo" class="form-label">
                                            Título
                                        </label>

                                        <input
                                            type="text"
                                            class="form-control"
                                            id="titulo"
                                            name="titulo"
                                            placeholder="Escribe el título del hilo..."
                                            required
                                        >

                                    </div>


                                    <div class="mb-3">

                                        <label for="contenido" class="form-label">
                                            Contenido
                                        </label>

                                        <textarea
                                            class="form-control"
                                            id="contenido"
                                            name="contenido"
                                            rows="6"
                                            placeholder="Escribe aquí tu pregunta o comentario..."
                                            required
                                        ></textarea>

                                    </div>

                                </div>


                                <div class="modal-footer">

                                    <button
                                        type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal"
                                    >
                                        Cancelar
                                    </button>

                                    <button
                                        type="submit"
                                        class="btn btn-color-base"
                                    >
                                        Publicar hilo
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>
                </div>
            </div>


            <div class="d-flex justify-content-between align-items-center mb-3">

                <!-- Titulo -->
                <h3 class="mb-0">
                    Hilos
                </h3>

                <!-- Filtro por programa -->
                <select
                    class="form-select"
                    style="width: 280px;"
                    id="filtroPrograma"
                    name="programa"
                >
                    <option value="" <%= !programaSeleccionado ? 'selected' : '' %>>
                        Todos los programas
                    </option>

                    <% programas.forEach(programa => { %>

                        <option
                            value="<%= programa.id_programa %>"
                            <%= String(programaSeleccionado) === String(programa.id_programa) ? 'selected' : '' %>
                        >
                            <%= programa.nombre_carrera %>
                        </option>

                    <% }) %>


                </select>

            </div>

            <!-- Lista de hilos -->
            <div class="list-group" id="listaHilos">

                <% hilos.forEach(hilo => { %>

                    <a
                        href="/foros/hilo/<%= hilo.id_hilo %>"
                        class="list-group-item list-group-item-action"
                    >
                        <div class="d-flex justify-content-between align-items-start">

                            <div class="me-3">

                                <h5 class="mb-1">
                                    <%= hilo.titulo %>
                                </h5>

                                <p class="mb-1 text-muted">
                                    <%= hilo.descripcion %>
                                </p>

                                <small class="text-muted">
                                    Publicado por: <%= hilo.usuario %>
                                </small>

                            </div>

                            <div class="text-end">

                                <small class="text-muted d-block">
                                    👍 <%= hilo.likes || 0 %> likes
                                </small>

                                <small class="text-muted d-block">
                                    💬 <%= hilo.respuestas || 0 %> respuestas
                                </small>

                                <small class="text-muted">
                                    <%= hilo.fecha %>
                                </small>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>

            <!-- Boton para cargar hilos extra -->
            <% if (hayMasHilos) { %>

                <div class="text-center mt-4" id="contenedorVerMas">

                    <button
                        type="button"
                        class="btn btn-color-base"
                        id="btnVerMas"
                    >
                        Ver más
                    </button>
                </div>
            <% } %>


            <!-- Sin hilos -->
            <% if (hilos.length === 0) { %>

                <div class="alert alert-warning mt-3">
                    No hay hilos disponibles en este foro.
                </div>
            <% } %>
                </div>
            </div>
        </div>


    </main>

    <!-- Inyectar Footer -->
    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    // Filtro por programa

    const filtroPrograma = document.getElementById('filtroPrograma');

    filtroPrograma.addEventListener('change', function () {

        const parametros = new URLSearchParams(window.location.search);

        if (this.value) {
            parametros.set('programa', this.value);
        } else {
            parametros.delete('programa');
        }

        // Reiniciar paginación al cambiar el filtro
        parametros.delete('offset');
        parametros.delete('ajax');

        const query = parametros.toString();

        window.location.href =
            window.location.pathname + (query ? '?' + query : '');

    });


    // Carga de los otros 10 hilos
    const btnVerMas = document.getElementById('btnVerMas');

    if (btnVerMas) {

        btnVerMas.addEventListener('click', async function () {

            const listaHilos = document.getElementById('listaHilos');

            // Cantidad de hilos que ya hay cargados
            const paginaActual = parseInt(
                new URLSearchParams(window.location.search).get('page')
            ) || 1;

            const siguientePagina = paginaActual + 1;

            // Preparar parámetros de la solicitud
            const parametros = new URLSearchParams(window.location.search);

            parametros.set('ajax', '1');
            parametros.set('page', siguientePagina);

            window.history.replaceState(
                {},
                '',
                `${window.location.pathname}?${parametros.toString()}`
            );

            // Para evitar multiples solicitudes simultaneas
            btnVerMas.disabled = true;
            btnVerMas.textContent = 'Cargando...';

            try {
                const respuesta = await fetch(
                    window.location.pathname + '?' + parametros.toString()
                );

                if (!respuesta.ok) {
                    throw new Error('No se pudieron cargar los hilos');
                }
                const datos = await respuesta.json();

                // Agregar cada hilo a la lista
                datos.hilos.forEach(hilo => {

                    const enlace = document.createElement('a');

                    enlace.href = `/foros/hilo/${encodeURIComponent(hilo.id_hilo)}`;
                    enlace.className = 'list-group-item list-group-item-action';

                    const contenedor = document.createElement('div');
                    contenedor.className = 'd-flex justify-content-between align-items-start';

                    // Informacion principal
                    const principal = document.createElement('div');
                    principal.className = 'me-3';

                    const titulo = document.createElement('h5');
                    titulo.className = 'mb-1';
                    titulo.textContent = hilo.titulo || '';

                    const descripcion = document.createElement('p');
                    descripcion.className = 'mb-1 text-muted';
                    descripcion.textContent = hilo.descripcion || '';

                    const autor = document.createElement('small');
                    autor.className = 'text-muted';
                    autor.textContent = `Publicado por: ${hilo.usuario || 'Usuario'}`;

                    principal.append(titulo, descripcion, autor);

                    // Informacion extra
                    const secundaria = document.createElement('div');
                    secundaria.className = 'text-end';

                    const likes = document.createElement('small');
                    likes.className = 'text-muted d-block';
                    likes.textContent = `👍 ${hilo.likes || 0} likes`;

                    const respuestas = document.createElement('small');
                    respuestas.className = 'text-muted d-block';
                    respuestas.textContent = `💬 ${hilo.respuestas || 0} respuestas`;

                    const fecha = document.createElement('small');
                    fecha.className = 'text-muted';
                    fecha.textContent = hilo.fecha || '';

                    secundaria.append(likes, respuestas, fecha);

                    contenedor.append(principal, secundaria);
                    enlace.appendChild(contenedor);

                    listaHilos.appendChild(enlace);

                });

                // Si no quedan más hilos quitar el botón
                if (!datos.hayMasHilos || datos.hilos.length === 0) {
                    document.getElementById('contenedorVerMas').remove();

                } else {
                    btnVerMas.disabled = false;
                    btnVerMas.textContent = 'Ver más';

                }
            } catch (error) {
                console.error('Error al cargar más hilos:', error);

                btnVerMas.disabled = false;
                btnVerMas.textContent = 'Ver más';

                alert('No fue posible cargar más hilos. Inténtalo nuevamente.');
            }
        });
    }
    </script>

</body>

</html>