<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Foros - <%= universidad.nombre %></title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

</head>

<body>
    <!-- 1. Inyectar Navbar -->
    <%- include('partials/navbar') %>
    
    <style>
    .btn-color-base {
        background-color: #8C9FBA;
        border-color: #8C9FBA;
        color: white;
    }

    .foro-fondo {
        background-color: #D3DCE5;
        border-radius: 25px;
        padding: 25px;
    }

    .foro-contenido {
        background-color: white;
        border-radius: 18px;
        padding: 30px;
    }

    </style>

    <main>
        <div class="container mt-5 mb-5">

            <!-- Cuadro exterior -->
            <div class="foro-fondo">

                <!-- Cuadro interior -->
                <div class="foro-contenido">

        <div class="container mt-5">

            <a href="/foros" class="btn btn-outline-secondary mb-4">
                ← Volver a universidades
            </a>

            <h1>
                Foros de <%= universidad.nombre %>
            </h1>

            <p class="text-muted">
                Busca una carrera para acceder a su foro.
            </p>

            
            <!-- Buscador -->

            <form
                action="/foros/universidad/<%= universidad.id_universidad %>"
                method="GET"
                class="mb-4"
            >

                <div class="input-group">
                    <input
                        type="text"
                        name="buscar"
                        class="form-control"
                        placeholder="Buscar carrera..."
                        value="<%= buscar || '' %>"
                    >

                    <button
                        type="submit"
                        class="btn btn-color-base"
                    >
                        Buscar
                    </button>

                </div>

            </form>


            <!-- Resultados -->

            <h3 class="mb-3">
                Carreras
            </h3>

            <% if (carreras.length === 0) { %>

                <div class="alert alert-warning">
                    No se encontraron carreras.
                </div>

            <% } else { %>

                <div class="list-group">

                    <% carreras.forEach(carrera => { %>

                        <div class="list-group-item d-flex justify-content-between align-items-center">

                            <div>

                                <h5 class="mb-1">
                                    <%= carrera.nombre_carrera %>
                                </h5>

                                <% if (carrera.descripcion_general) { %>

                                    <p class="mb-0 text-muted">
                                        <%= carrera.descripcion_general %>
                                    </p>

                                <% } %>

                            </div>

                            <a
                                href="/foros/carrera/<%= carrera.id_carrera_base %>"
                                class="btn btn-outline-color-base"
                            >
                                Ver foro

                            </a>
                        </div>
                    <% }) %>
                </div>
            <% } %>
                </div>
            </div>
        </div>

    </main>

    <!-- Inyectar Footer -->
    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
