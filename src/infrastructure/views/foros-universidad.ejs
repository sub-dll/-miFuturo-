<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foros - <%= universidad.nombre %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/global.css" rel="stylesheet">
</head>
<body class="bg-light">
    
    <%- include('partials/navbar') %>

    <main class="container py-5" style="max-width: 1100px;">
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-4">← Volver al inicio</a>

        <!-- Banner Superior tipo Figma -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background-color: #8C9FBA; color: white;">
            <div class="d-flex align-items-center gap-4">
                <% if (universidad.logo_url) { %>
                    <img src="<%= universidad.logo_url %>" alt="Logo" class="rounded-circle bg-white border p-1" style="width: 100px; height: 100px; object-fit: cover;">
                <% } %>
                <div>
                    <h1 class="fw-bold mb-1"><%= universidad.nombre %></h1>
                    <div class="d-flex gap-3 mt-2">
                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill shadow-sm"><%= universidad.ciudad %></span>
                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill shadow-sm"><%= carreras.length %> Carreras</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: Buscador y Listado de Carreras -->
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold mb-0">Foros por Carrera</h3>
                </div>

                <form action="/foros/<%= universidad.id_universidad %>" method="GET" class="mb-4">
                    <div class="input-group shadow-sm rounded-pill overflow-hidden">
                        <input type="text" name="buscar" class="form-control border-0 px-4 py-2" placeholder="Busca la carrera de tu preferencia..." value="<%= buscar || '' %>">
                        <button type="submit" class="btn text-white px-4" style="background-color: #2c3e50;">Buscar</button>
                    </div>
                </form>

                <% if (carreras.length > 0) { %>
                    <div class="d-flex flex-column gap-3">
                        <% carreras.forEach(carrera => { %>
                            <div class="card border-0 shadow-sm rounded-4 hover-card p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="fw-bold mb-1"><%= carrera.nombre_carrera %></h5>
                                    </div>
                                    <a href="/foros/<%= universidad.id_universidad %>/<%= carrera.id_carrera_base %>" class="btn btn-sm rounded-pill px-4 text-white" style="background-color: #8C9FBA;">Entrar al Foro</a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="alert alert-secondary border-0 rounded-4">No se encontraron carreras.</div>
                <% } %>
            </div>

            <!-- COLUMNA DERECHA: Información Institucional -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: #8C9FBA; color: white;">
                    <h5 class="fw-bold mb-3">Información de la Universidad</h5>
                    <p class="small opacity-75 mb-4 text-justify">
                        <%= universidad.descripcion || 'Sin descripción disponible.' %>
                    </p>
                    <hr class="border-white opacity-50 mb-3">
                    <div class="mb-3">
                        <h6 class="fw-bold mb-1">Acreditación</h6>
                        <span class="small"><%= universidad.años_acreditacion ? universidad.años_acreditacion + ' Años' : 'No especificado' %></span>
                    </div>
                    <div class="mb-4">
                        <h6 class="fw-bold mb-1">Sitio Web</h6>
                        <% if (universidad.sitio_web) { %>
                            <a href="<%= universidad.sitio_web %>" target="_blank" class="text-white small text-decoration-underline"><%= universidad.sitio_web %></a>
                        <% } else { %>
                            <span class="small">No disponible</span>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>