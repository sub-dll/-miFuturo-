<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>miFuturo - Home</title>
    <!-- Importación de Bootstrap para los estilos base -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Enlace a tu archivo CSS personalizado -->
    <link rel="stylesheet" href="/css/global.css">
    
    <style>
        /* Asegura que el footer quede siempre en la parte inferior de la pantalla si hay poco contenido */
        body { min-height: 100vh; display: flex; flex-direction: column; background-color: #F8F9FA; }
    </style>
</head>

<script>
        // Lógica de filtrado en tiempo real para la vista Home (se ejecuta en el navegador del usuario)
        document.addEventListener('DOMContentLoaded', () => {
            // Obtenemos los elementos del DOM (el selector de ciudad y el buscador de texto)
            const filtroCiudad = document.getElementById('filtroCiudad');
            const buscadorUniversidad = document.getElementById('buscadorUniversidad');
            // Obtenemos todas las tarjetas de universidades renderizadas
            const tarjetas = document.querySelectorAll('.uni-card');

            // Función que evalúa si una tarjeta debe mostrarse u ocultarse
            function aplicarFiltros() {
                const ciudadSeleccionada = filtroCiudad.value;
                const textoBuscado = buscadorUniversidad.value.toLowerCase();

                tarjetas.forEach(tarjeta => {
                    // Extraemos la ciudad y el nombre de cada tarjeta
                    const ciudadTarjeta = tarjeta.getAttribute('data-ciudad');
                    const nombreTarjeta = tarjeta.querySelector('.nombre-uni').textContent.toLowerCase();
                    
                    // Verificamos si la tarjeta cumple con ambos filtros
                    const coincideCiudad = (ciudadSeleccionada === 'todas') || (ciudadTarjeta === ciudadSeleccionada);
                    const coincideTexto = nombreTarjeta.includes(textoBuscado);

                    // Mostramos u ocultamos la tarjeta según el resultado
                    if (coincideCiudad && coincideTexto) {
                        tarjeta.style.display = 'block';
                    } else {
                        tarjeta.style.display = 'none';
                    }
                });
            }

            // Escuchamos los cambios en los filtros para aplicar la lógica al instante
            filtroCiudad.addEventListener('change', aplicarFiltros);
            buscadorUniversidad.addEventListener('input', aplicarFiltros);
        });
</script>

<body>

    <!-- 1. Inyección de la barra de navegación superior (Navbar) -->
    <%- include('partials/navbar') %>

   <!-- 2. Contenedor principal de la página de inicio -->
    <main class="container d-flex flex-column mt-5 flex-grow-1 px-4" style="max-width: 1200px;">
        
        <!-- Cuadro contenedor de fondo gris/celeste (min-height empuja el footer hacia abajo) -->
        <div class="p-4 p-md-5 flex-grow-1 w-100" style="background-color: #dbe2eb; border-radius: 2rem 2rem 0 0; min-height: 80vh;">
            
           <!-- Sección de Filtros de búsqueda -->
            <div class="card border-0 shadow-sm mb-4" style="max-width: 600px; border-radius: 1.5rem;">
                <div class="card-body p-4">
                    <h4 class="mb-3 fw-normal">Filtros</h4>
                    <div class="row gap-3 gap-md-0">
                        <!-- Filtro por Ciudad -->
                        <div class="col-md-6">
                            <select id="filtroCiudad" class="form-select text-white border-0 shadow-sm" style="background-color: #8C9FBA;">
                                <option value="todas" selected>[ Todas las ciudades ]</option>
                                <!-- Iteramos las ciudades dinámicamente si existen -->
                                <% if (typeof ciudades !== 'undefined') { %>
                                    <% ciudades.forEach(ciudad => { %>
                                        <option value="<%= ciudad %>"><%= ciudad %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <!-- Filtro por Nombre de Universidad -->
                        <div class="col-md-6">
                            <input type="text" id="buscadorUniversidad" class="form-control text-white border-0 shadow-sm placeholder-white" style="background-color: #8C9FBA;" placeholder="Buscar universidad...">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lista Dinámica de Universidades extraídas de MySQL -->
            <div id="listaUniversidades">
                <!-- Comprobamos si el backend envió universidades -->
                <% if (typeof universidades !== 'undefined' && universidades.length > 0) { %>
                    <!-- Iteramos sobre cada universidad y creamos su tarjeta -->
                    <% universidades.forEach(uni => { %>
                        <div class="card border-0 shadow-sm rounded-4 mb-3 hover-card uni-card" data-ciudad="<%= uni.ciudad %>">
                            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3 gap-md-4">
                                    <!-- Renderizamos el logo si existe, si no, mostramos un icono por defecto -->
                                    <% if (uni.logo_url) { %>
                                        <img src="<%= uni.logo_url %>" alt="Logo" class="rounded-circle border" style="width: 65px; height: 65px; object-fit: cover;">
                                    <% } else { %>
                                        <div class="rounded-circle bg-light d-flex justify-content-center align-items-center border" style="width: 65px; height: 65px;">
                                            <span class="fs-4">🏛️</span>
                                        </div>
                                    <% } %>
                                    <!-- Nombre y ciudad de la institución -->
                                    <div>
                                        <h5 class="mb-0 fw-normal nombre-uni"><%= uni.nombre %></h5>
                                        <small class="text-muted"><%= uni.ciudad %></small>
                                    </div>
                                </div>
                                
                                <!-- ESTE ES EL CAMBIO CLAVE PARA EL FLUJO 1:
                                     Ahora el botón apunta a la vista institucional de la universidad (/universidad/:id)
                                     y no directo a los foros. -->
                                <a href="/universidad/<%= uni.id_universidad %>" class="btn btn-ver-mas rounded-pill px-4 stretched-link">Ver más</a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <!-- Mensaje de respaldo por si la base de datos está vacía -->
                    <div class="alert alert-secondary border-0 text-center rounded-4">No hay universidades disponibles en este momento.</div>
                <% } %>
            </div>

        </div>
    </main>

    <!-- 3. Inyección del pie de página (Footer) -->
    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>