<!-- Modal de Perfil Flotante - Con Casillas Holgadas y Estilizadas -->
<% if (locals.usuario) { %>
<style>
  /* Tipografía Serif y Colores exactos */
  #modalPerfil {
    font-family: 'Port Lligat Slab', Georgia, serif;
  }
  
  /* Contenedor Principal del Modal */
  #modalPerfil .modal-content-exact {
    background-color: #7e8c9d;
    border-radius: 20px;
    overflow: hidden;
    height: 82vh;
  }

  /* Sidebar Lateral Izquierda */
  #modalPerfil .sidebar-exact {
    background-color: #bdc9d7;
    color: #2b3644;
  }

  /* Botones del Menú Lateral */
  #modalPerfil .sidebar-exact .nav-link {
    color: #2b3644 !important;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 12px;
    padding: 8px 16px;
    transition: all 0.2s ease;
    text-align: left;
    border: none;
    background: transparent;
  }

  #modalPerfil .sidebar-exact .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.25);
  }

  #modalPerfil .sidebar-exact .nav-link.active {
    background-color: #a3b2c2 !important;
    color: #1a232e !important;
  }

  /* Botones Estilo Píldora [ Guardar ... ] */
  #modalPerfil .btn-pill-custom {
    background-color: rgba(255, 255, 255, 0.28);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 8px;
    padding: 6px 18px;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  #modalPerfil .btn-pill-custom:hover {
    background-color: rgba(255, 255, 255, 0.45);
    color: #ffffff;
  }

  /* Desplegables Estilo Píldora Holgados */
  #modalPerfil .select-pill-custom {
    background-color: rgba(255, 255, 255, 0.2) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
    border-radius: 8px;
    padding: 6px 36px 6px 16px !important; /* Espacio extra para la flecha */
    font-size: 0.85rem;
    min-width: 150px; /* Evita que el texto quede apretado */
    text-align: left;
    cursor: pointer;
  }

  #modalPerfil .select-pill-custom option {
    background-color: #64748b;
    color: #ffffff;
  }

  /* Inputs de Texto Holgados */
  #modalPerfil .input-pill-custom {
    background-color: rgba(255, 255, 255, 0.2) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
    border-radius: 8px;
    padding: 6px 16px !important;
    font-size: 0.85rem;
    min-width: 200px;
  }

  #modalPerfil .input-pill-custom::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  /* Campo de Texto Biografía */
  #modalPerfil .textarea-exact {
    background-color: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    border-radius: 10px;
  }

  #modalPerfil .textarea-exact::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  /* Scrollbar discreto */
  #modalPerfil .modal-scrollable::-webkit-scrollbar {
    width: 5px;
  }
  #modalPerfil .modal-scrollable::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
  }
</style>

<div class="modal fade" id="modalPerfil" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content modal-content-exact border-0 shadow-lg">
      
      <div class="row g-0 h-100">
        
        <!-- Sidebar Lateral Izquierdo -->
        <aside class="col-md-3 p-4 sidebar-exact d-flex flex-column">
          <small class="text-secondary fw-semibold mb-2" style="font-size: 0.8rem; color: #5a6878 !important;">Cuenta</small>
          
          <div class="nav flex-column nav-pills gap-1" id="v-pills-tab" role="tablist" aria-orientation="vertical">
            
            <!-- Pestaña Cuenta / Avatar -->
            <button class="nav-link active d-flex align-items-center gap-2 mb-2" id="v-pills-cuenta-tab" data-bs-toggle="pill" data-bs-target="#v-pills-cuenta" type="button" role="tab">
              <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; min-width: 32px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-person-fill" viewBox="0 0 16 16">
                  <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                </svg>
              </div>
              <span class="text-truncate"><%= locals.usuario.nombre || locals.usuario.nombres || locals.usuario.username || 'Usuario' %></span>
            </button>

            <!-- Pestaña Preferencias -->
            <button class="nav-link" id="v-pills-preferencias-tab" data-bs-toggle="pill" data-bs-target="#v-pills-preferencias" type="button" role="tab">
              Preferencias
            </button>

            <!-- Pestaña Notificaciones -->
            <button class="nav-link" id="v-pills-notificaciones-tab" data-bs-toggle="pill" data-bs-target="#v-pills-notificaciones" type="button" role="tab">
              Notificaciones
            </button>

          </div>
        </aside>

        <!-- Contenido Principal -->
        <main class="col-md-9 p-4 p-md-5 overflow-y-auto modal-scrollable h-100 text-white position-relative">
          
          <!-- Botón de Cierre X -->
          <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-4" data-bs-dismiss="modal" aria-label="Close"></button>

          <div class="tab-content" id="v-pills-tabContent">
            
            <!-- PESTAÑA 1: CUENTA (INCLUYE BIOGRAFÍA) -->
            <div class="tab-pane fade show active" id="v-pills-cuenta" role="tabpanel">
              <h1 class="fs-2 mb-0">Cuenta</h1>
              <p class="small text-white-50 mb-4">Cambia configuracion de la cuenta de usuario</p>

              <form action="/perfil/cuenta/actualizar" method="POST">
                
                <!-- Datos de contacto -->
                <h5 class="fs-6 fw-bold mt-4 mb-2">Datos de contacto</h5>
                <hr class="border-white opacity-25 mt-0 mb-4">

                <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
                  <div>
                    <div class="fw-semibold fs-6">Correo Electronico</div>
                    <small class="text-white-50">En este correo llegaran notificaciones de mensajes</small>
                  </div>
                  <input type="email" name="email" class="form-control input-pill-custom w-auto text-end" value="<%= (locals.usuario && locals.usuario.email) ? locals.usuario.email : '' %>" required>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-5 gap-3">
                  <div>
                    <div class="fw-semibold fs-6">Numero de telefono</div>
                    <small class="text-white-50">Necesario para verificar la cuenta</small>
                  </div>
                  <input type="text" name="telefono" class="form-control input-pill-custom w-auto text-end" value="<%= (locals.usuario && locals.usuario.telefono) ? locals.usuario.telefono : '' %>" placeholder="Sin teléfono">
                </div>

                <!-- Credenciales de usuario -->
                <h5 class="fs-6 fw-bold mt-4 mb-2">Cambiar nombre de usuario / contraseña</h5>
                <hr class="border-white opacity-25 mt-0 mb-4">

                <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
                  <div>
                    <div class="fw-semibold fs-6">Nombre de usuario</div>
                    <small class="text-white-50">Este es el nombre que se visualizara en los foros</small>
                  </div>
                  <input type="text" name="username" class="form-control input-pill-custom w-auto text-end" value="<%= (locals.usuario && locals.usuario.username) ? locals.usuario.username : '' %>">
                </div>

                <div class="d-flex justify-content-between align-items-center mb-5 gap-3">
                  <div>
                    <div class="fw-semibold fs-6">Cambio de contraseña</div>
                    <small class="text-white-50">Deja en blanco si no te acuerdas de ella o no deseas cambiarla</small>
                  </div>
                  <input type="password" name="password" class="form-control input-pill-custom w-auto text-end" placeholder="••••••••">
                </div>

                <!-- Información del Perfil / Biografía -->
                <h5 class="fs-6 fw-bold mt-4 mb-2">Sobre mí</h5>
                <hr class="border-white opacity-25 mt-0 mb-4">

                <div class="mb-4">
                  <div class="fw-semibold fs-6 mb-1">Biografía o descripción corta</div>
                  <small class="text-white-50 d-block mb-3">Cuéntanos brevemente sobre ti, tus intereses o tu carrera profesional.</small>
                  <textarea class="form-control textarea-exact p-3" id="biografia" name="biografia" rows="4" maxlength="280" placeholder="Escribe tu biografía aquí..."><%= (locals.usuario && locals.usuario.biografia) ? locals.usuario.biografia : '' %></textarea>
                </div>

                <div class="text-end mt-4">
                  <button type="submit" class="btn btn-pill-custom">[ Guardar cuenta ]</button>
                </div>

              </form>
            </div>

            <!-- PESTAÑA 2: PREFERENCIAS -->
            <div class="tab-pane fade" id="v-pills-preferencias" role="tabpanel">
              <h1 class="fs-2 mb-0">Preferencias</h1>
              <p class="small text-white-50 mb-4">Elige como quieres ver [miFuturo] y establece sus preferencias</p>

              <form action="/perfil/preferencias/actualizar" method="POST">
                
                <h5 class="fs-6 fw-bold mt-4 mb-2">Aparencia</h5>
                <hr class="border-white opacity-25 mt-0 mb-4">

                <div class="d-flex justify-content-between align-items-center mb-4">
                  <div>
                    <div class="fw-semibold fs-6">Temas</div>
                    <small class="text-white-50">Elige un tema para [miFuturo] en este dispositivo</small>
                  </div>
                  <select name="tema" class="form-select select-pill-custom w-auto">
                    <option value="oscuro">[ Oscuro ]</option>
                    <option value="claro">[ Claro ]</option>
                  </select>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-5">
                  <div>
                    <div class="fw-semibold fs-6">Contraste alto</div>
                    <small class="text-white-50">Aumenta el contraste para mejorar la visibilidad</small>
                  </div>
                  <select name="contraste" class="form-select select-pill-custom w-auto">
                    <option value="activado">[ Activado ]</option>
                    <option value="desactivado">[ Desactivado ]</option>
                  </select>
                </div>

                <h5 class="fs-6 fw-bold mt-4 mb-2">Idioma y hora</h5>
                <hr class="border-white opacity-25 mt-0 mb-4">

                <div class="d-flex justify-content-between align-items-center mb-4">
                  <div>
                    <div class="fw-semibold fs-6">Idioma</div>
                    <small class="text-white-50">Elige el idioma en el que quieres usar [miFuturo]</small>
                  </div>
                  <select name="idioma" class="form-select select-pill-custom w-auto">
                    <option value="es">[ Español ]</option>
                    <option value="en">[ English ]</option>
                  </select>
                </div>

                <div class="text-end mt-4">
                  <button type="submit" class="btn btn-pill-custom">[ Guardar preferencias ]</button>
                </div>

              </form>
            </div>

            <!-- PESTAÑA 3: NOTIFICACIONES -->
            <div class="tab-pane fade" id="v-pills-notificaciones" role="tabpanel">
              <h1 class="fs-2 mb-0">Notificaciones</h1>
              <p class="small text-white-50 mb-4">Gestiona las alertas y notificaciones que recibes</p>

              <form action="/perfil/notificaciones/actualizar" method="POST">
                
                <h5 class="fs-6 fw-bold mt-4 mb-2">Avisos del sistema</h5>
                <hr class="border-white opacity-25 mt-0 mb-4">

                <div class="d-flex justify-content-between align-items-center mb-4">
                  <div>
                    <div class="fw-semibold fs-6">Notificaciones por correo</div>
                    <small class="text-white-50">Recibe alertas sobre respuestas en foros y novedades</small>
                  </div>
                  <select name="notificaciones_email" class="form-select select-pill-custom w-auto">
                    <option value="activado">[ Activado ]</option>
                    <option value="desactivado">[ Desactivado ]</option>
                  </select>
                </div>

                <div class="text-end mt-4">
                  <button type="submit" class="btn btn-pill-custom">[ Guardar notificaciones ]</button>
                </div>

              </form>
            </div>

          </div>
        </main>

      </div>
    </div>
  </div>
</div>
<% } %>