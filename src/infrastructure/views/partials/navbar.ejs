<nav class="navbar navbar-expand-lg bg-white shadow-sm px-4 py-3" style="position: relative; z-index: 1050;">
  <div class="container-fluid d-flex justify-content-between align-items-center">
    
    <!-- Lado Izquierdo: Icono de menú / chat -->
    <div>
        <button class="btn btn-light rounded-circle p-2" aria-label="Mensajes">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-chat-left-text" viewBox="0 0 16 16">
                <path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/>
                <path d="M3 3.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5M3 6a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 6m0 2.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/>
            </svg>
        </button>
    </div>

    <!-- Centro: Logo -->
    <a class="navbar-brand fs-3 fw-bold position-absolute start-50 translate-middle-x text-dark m-0" href="/">
        [miFuturo]
    </a>

    <!-- Lado Derecho: Lógica de Sesión -->
    <div class="d-flex align-items-center gap-3">
        
        <% if (locals.usuario) { %>
            <!-- === SI HAY SESIÓN: Muestra Campana y Avatar === -->
            
            <!-- Campana de Notificaciones -->
            <div class="dropdown">
                <button class="btn btn-light rounded-circle p-2 position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-bell" viewBox="0 0 16 16">
                        <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2M8 1.918l-.797.161A4 4 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4 4 0 0 0-3.203-3.92zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5 5 0 0 1 13 6c0 .88.32 4.2 1.22 6"/>
                    </svg>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="width: 260px;">
                    <li><h6 class="dropdown-header fw-bold text-dark fs-6">Notificaciones</h6></li>
                    <li><hr class="dropdown-divider"></li>
                    <li class="px-3 py-2 text-muted text-center"><small>No tienes notificaciones pendientes</small></li>
                </ul>
            </div>

            <!-- Avatar Dropdown -->
            <div class="dropdown">
                <button class="btn btn-link p-0 border-0 text-decoration-none dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center" style="width: 35px; height: 35px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-fill" viewBox="0 0 16 16">
                            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                        </svg>
                    </div>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow mt-2" style="min-width: 210px; border-radius: 12px;">
                    <li class="px-3 py-2 border-bottom">
                        <span class="d-block text-muted small fw-bold">Cuenta activa</span>
                        <span class="d-block fw-bold text-dark"><%= locals.usuario.nombre || locals.usuario.nombres || locals.usuario.email || 'Usuario' %></span>
                    </li>
                    
                    <!-- Opción de Configuración lista para conectar con el Modal -->
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-dark d-flex align-items-center gap-2" href="#" data-bs-toggle="modal" data-bs-target="#modalConfiguracion">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-gear-fill" viewBox="0 0 16 16">
                                <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.86"/>
                            </svg>
                            <span>Configuración</span>
                        </a>
                    </li>

                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <a class="dropdown-item py-2 fw-semibold text-danger d-flex align-items-center gap-2" href="/logout">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-box-arrow-right" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                                <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                            </svg>
                            <span>Cerrar Sesión</span>
                        </a>
                    </li>
                </ul>
            </div>

        <% } else { %>
            <!-- === SI NO HAY SESIÓN: Muestra Botones de Ingreso === -->
            <a href="/registro" class="btn text-white btn-sm px-3" style="background-color: #8C9FBA; border: none; font-weight: 500;">Registro</a>
            <a href="/login" class="btn btn-outline-dark btn-sm px-3" style="font-weight: 500;">Login</a>
        <% } %>
        
    </div>
  </div>
</nav>