<% const _maxBar = Math.max(...programa.matriculas_vs_titulados.flatMap(d => [d.matriculados, d.titulados])); %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= programa.nombre_carrera %> - <%= programa.uni_nombre %> - miFuturo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/global.css" rel="stylesheet">
</head>
<body class="bg-light">

<%- include('partials/navbar') %>

<main class="container py-4" style="max-width: 900px;">

    <!-- Botón volver al Home -->
    <a href="/" class="btn btn-light btn-sm rounded-pill mb-3 shadow-sm px-4">← Volver al inicio</a>

    <!-- Encabezado universidad -->
    <div class="card border-0 shadow-sm rounded-4 hover-card p-3 mb-3 d-flex flex-row align-items-center gap-3">
        <% if (programa.uni_logo) { %>
            <img src="<%= programa.uni_logo %>" alt="Logo" style="width:56px;height:56px;border-radius:50%;object-fit:cover;" class="border">
        <% } else { %>
            <div style="width:56px;height:56px;border-radius:50%;background:#EAEEF5;"></div>
        <% } %>
        <div>
            <h1 class="h4 fw-bold mb-0"><%= programa.uni_nombre %></h1>
            <span class="text-muted small"><%= programa.uni_ciudad %></span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <!-- Columna izquierda: carrera + descripcion + requisitos -->
        <div class="col-lg-6 d-flex flex-column gap-3">
            <div class="card border-0 shadow-sm rounded-4 hover-card p-4">
                <h2 class="h5 fw-bold mb-2 text-dark">[<%= programa.nombre_carrera %>]</h2>
                <p class="small mb-4 text-justify"><%= programa.descripcion_general %></p>
                
                <h6 class="fw-bold small text-muted mb-2">Identidad y Desempeño</h6>
                <div class="small text-muted mb-3 text-justify" style="white-space: pre-line;">
                    <strong>Competencias:</strong>
                    <%= programa.competencias || 'No especificadas.' %>
                </div>
                <div class="small text-muted mb-4 text-justify">
                    <strong>Áreas de Desempeño:</strong> <%= programa.areas_desempeno || 'No especificadas.' %>
                </div>

                <h6 class="fw-bold small text-muted mb-2">Detalles del Programa</h6>
                <ul class="small mb-0 text-muted list-unstyled" style="line-height: 1.8;">
                    <li><strong>Código DEMRE:</strong> <%= programa.codigo_demre || 'No especificado' %></li>
                    <li><strong>Título Profesional:</strong> <%= programa.titulo_profesional || '--' %></li>
                    <li><strong>Grado Académico:</strong> <%= programa.grado_academico || '--' %></li>
                    <li><strong>Modalidad:</strong> <%= programa.modalidad || '--' %></li>
                    <li><strong>Duración:</strong> <%= programa.semestres ? programa.semestres + ' semestres' : '--' %></li>
                    <li><strong>Arancel Anual:</strong> $<%= programa.arancel ? programa.arancel.toLocaleString('es-CL') : '--' %></li>
                    <li><strong>Vacantes:</strong> <%= programa.vacantes_paes || '--' %> PAES | <%= programa.vacantes_pace || '--' %> PACE</li>
                </ul>
            </div>
            
            <div class="card border-0 shadow-sm rounded-4 hover-card p-4">
                <h2 class="h5 fw-bold mb-3">[Requisitos de Ingreso]</h2>
                <p class="small mb-1 fw-bold text-dark">Puntaje de corte: <span class="fw-normal"><%= programa.pct_corte || '--' %> puntos</span></p>
                
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <span class="badge bg-secondary">NEM: <%= programa.pct_nem || 0 %>%</span>
                    <span class="badge bg-secondary">Ranking: <%= programa.pct_ranking || 0 %>%</span>
                    <span class="badge bg-primary">M1: <%= programa.pct_m1 || 0 %>%</span>
                    <span class="badge bg-info text-dark">M2: <%= programa.pct_m2 || 0 %>%</span>
                    <span class="badge bg-success">Lectora: <%= programa.pct_lectora || 0 %>%</span>
                    <span class="badge bg-warning text-dark">Historia/Ciencias: <%= programa.pct_ciencias_historia || 0 %>%</span>
                </div>
            </div>
        </div>

        <!-- Columna derecha: grafico + empleabilidad + sueldos -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 hover-card p-4 h-100">
                <p class="small fw-bold mb-3">Matriculados vs. Titulados por año</p>
                <div class="d-flex align-items-center gap-3 small mb-4">
                    <span><span style="display:inline-block;width:10px;height:10px;background:#dfe6ee;margin-right:4px;"></span>Matriculados</span>
                    <span><span style="display:inline-block;width:10px;height:10px;background:#8C9FBA;margin-right:4px;"></span>Titulados</span>
                </div>

                <!-- Gráfico de Barras -->
                <!-- Gráfico de Barras -->
                <div class="d-flex justify-content-between align-items-end mb-4" style="height: 120px;">
                    <% programa.matriculas_vs_titulados.forEach(function (d) { 
                        const hMat = Math.round((d.matriculados / _maxBar) * 100);
                        const hTit = Math.round((d.titulados / _maxBar) * 100);
                        
                        /* Armamos el string del estilo aquí arriba para que VS Code no llore */
                        const styleMat = `width:12px;background:#dfe6ee;border-radius:2px 2px 0 0;height:${hMat}%;`;
                        const styleTit = `width:12px;background:#8C9FBA;border-radius:2px 2px 0 0;height:${hTit}%;`;
                    %>
                        <div class="d-flex flex-column align-items-center justify-content-end h-100 w-100">
                            <div class="d-flex align-items-end justify-content-center gap-1 w-100" style="height: 100%;">
                                <!-- Y lo inyectamos limpiamente -->
                                <div <%- `style="${styleMat}"` %>></div>
                                <div <%- `style="${styleTit}"` %>></div>
                            </div>
                            <span class="small mt-2 text-muted" style="font-size: 0.75rem;"><%= d.anio %></span>
                        </div>
                    <% }); %>
                </div>

                <hr class="opacity-25 my-3">

                <p class="small fw-bold mb-1">Empleabilidad:</p>
                <p class="small text-muted mb-3">El <strong><%= programa.empleabilidad_pct || '--' %>%</strong> de los egresados se encuentra trabajando al primer año tras titularse (fuente: mifuturo.cl).</p>

                <p class="small fw-bold mb-1">Ingresos promedio:</p>
                <p class="small text-muted mb-0">
                    $<%= programa.sueldo_promedio_1er_ano ? programa.sueldo_promedio_1er_ano.toLocaleString('es-CL') : '--' %> al primer año y
                    $<%= programa.sueldo_promedio_2do_ano ? programa.sueldo_promedio_2do_ano.toLocaleString('es-CL') : '--' %> al segundo año de titulación.
                </p>
            </div>
        </div>
    </div>

    <!-- Sitio web oficial -->
    <div class="card border-0 shadow-sm rounded-4 hover-card text-center p-4 mb-3" style="background-color: #f8fafc;">
        <p class="fw-bold mb-3 text-dark">Sitio web oficial de la institución</p>
        <a href="<%= programa.uni_web %>" target="_blank" rel="noopener" class="btn btn-outline-secondary rounded-pill mx-auto px-5" style="width: fit-content;">Visitar portal</a>
    </div>

    <!-- FORO: Conectado a la ruta dinámica -->
    <div class="text-center mt-5 mb-4">
        <p class="text-muted small mb-2">¿Tienes dudas sobre esta carrera? Pregúntale a la comunidad.</p>
        <a href="/foros/<%= programa.id_universidad %>/<%= programa.id_carrera_base %>?programa=<%= programa.id_programa %>" class="btn btn-lg rounded-pill px-5 text-white shadow" style="background-color: #2c3e50;">
            IR AL FORO DE LA CARRERA
        </a>
    </div>

</main>

<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>