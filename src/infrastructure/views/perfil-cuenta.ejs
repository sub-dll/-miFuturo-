<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - Cuenta</title>
    <!-- Bootstrap 5 CSS (v5.3.3) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts: Port Lligat Slab -->
    <link href="https://fonts.googleapis.com/css2?family=Port+Lligat+Slab&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #64748b;
            min-height: 100vh;
            font-family: 'Port Lligat Slab', serif;
        }
        /* Capa semitransparente para el fondo */
        .modal-overlay {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(8px);
        }
        /* Contenedor emergente principal */
        .modal-box {
            background-color: #78869b;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            max-width: 1000px;
            width: 90%;
            height: 80vh;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .content-area {
            color: #f8fafc;
        }
        .valor-actual {
            color: #0f172a;
            background-color: rgba(255, 255, 255, 0.85);
            border-radius: 0.375rem;
            padding: 0.2rem 0.6rem;
            display: inline-block;
            margin-top: 0.25rem;
            font-weight: 500;
        }
        a.nav-link {
            color: #ffffff !important;
        }
    </style>
</head>
<body class="m-0 text-white">

    <!-- Mensajes de alerta del servidor -->
    <div id="alert-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1060;">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
                <strong>Error:</strong> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof exito !== 'undefined' && exito) { %>
            <div class="alert alert-success alert-dismissible fade show shadow auto-cerrar" role="alert">
                <strong>¡Éxito!</strong> <%= exito %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    </div>

    <!-- 1. NAVBAR GLOBAL -->
    <%- include('partials/navbar') %>

    <!-- 2. CAPA OVERLAY FLOTANTE CENTRADA -->
    <div class="modal-overlay position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-3" style="top: 76px !important; height: calc(100vh - 76px) !important; z-index: 1040;">
        
        <!-- TARJETA DEL MODAL -->
        <div class="modal-box d-flex overflow-hidden">
            <div class="row g-0 w-100 h-100">
                
                <!-- Sidebar lateral -->
                <%- include('partials/sidebar-perfil', { active: 'cuenta' }) %>

                <!-- Área Principal de Contenido -->
                <div class="col-md-9 col-lg-9 p-4 p-md-5 overflow-y-auto h-100 content-area">
                    
                    <!-- Botón X para cerrar la ventana emergente -->
                    <div class="text-end mb-2">
                        <a href="/" class="btn-close btn-close-white" aria-label="Cerrar"></a>
                    </div>

                    <h1 class="fs-3 fw-bold mb-0">Cuenta</h1>
                    <p class="fs-6 text-light opacity-75 mb-1">Cambia configuración de la cuenta de usuario</p>
                    <p class="fs-5 mb-4 text-white" id="saludo-usuario">
                        Hola, <strong><%= usuario.nombres %><%= usuario.apellidos ? ' ' + usuario.apellidos : '' %></strong>
                    </p>

                    <h5 class="fw-bold fs-6 mt-4 text-white">Datos de contacto</h5>
                    <hr class="border-white border-opacity-50 my-3">

                    <!-- Correo Electrónico -->
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            <div class="fw-bold">Correo Electrónico</div>
                            <small class="text-light opacity-75">En este correo llegarán notificaciones de mensajes</small><br>
                            <span class="valor-actual" id="valor-email"><%= usuario.email %></span>
                        </div>
                        <div class="col-md-4 text-md-end mt-2 mt-md-0">
                            <button class="btn btn-outline-light btn-sm" onclick="abrirModalModificacion('email', 'Correo Electrónico')">Modificar</button>
                        </div>
                    </div>

                    <!-- Número de teléfono -->
                    <div class="row align-items-center mb-5">
                        <div class="col-md-8">
                            <div class="fw-bold">Número de teléfono</div>
                            <small class="text-light opacity-75">Necesario para verificar la cuenta</small><br>
                            <span class="valor-actual" id="valor-telefono"><%= usuario.telefono || 'Sin teléfono registrado' %></span>
                        </div>
                        <div class="col-md-4 text-md-end mt-2 mt-md-0">
                            <button class="btn btn-outline-light btn-sm" onclick="abrirModalModificacion('telefono', 'Número de Teléfono')">Modificar</button>
                        </div>
                    </div>

                    <h5 class="fw-bold fs-6 mt-4 text-white">Cambiar nombre de usuario / contraseña</h5>
                    <hr class="border-white border-opacity-50 my-3">

                    <!-- Nombre de usuario -->
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            <div class="fw-bold">Nombre de usuario</div>
                            <small class="text-light opacity-75">Este es el nombre que se visualizará en los foros</small><br>
                            <span class="valor-actual" id="valor-username"><%= usuario.username || 'Sin nombre de usuario' %></span>
                        </div>
                        <div class="col-md-4 text-md-end mt-2 mt-md-0">
                            <button class="btn btn-outline-light btn-sm" onclick="abrirModalModificacion('username', 'Nombre de Usuario')">Modificar</button>
                        </div>
                    </div>

                    <!-- Cambio de contraseña -->
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            <div class="fw-bold">Cambio de contraseña</div>
                            <small class="text-light opacity-75">Restablece la contraseña si no te acuerdas de ella</small>
                        </div>
                        <div class="col-md-4 text-md-end mt-2 mt-md-0">
                            <button class="btn btn-outline-light btn-sm" onclick="abrirModalModificacion('password', 'Contraseña')">Modificar</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Modal emergente para la edición de campos de formulario -->
    <div class="modal fade" id="modalModificar" tabindex="-1" aria-hidden="true" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content text-dark" id="formModificar" method="POST" action="/perfil/actualizar" style="font-family: 'Port Lligat Slab', serif;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalTitulo">Modificar dato</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="campo" id="inputCampo">
                    <div class="mb-3">
                        <label for="inputValue" class="form-label fw-bold" id="labelInput">Nuevo valor:</label>
                        <input type="text" class="form-control" id="inputValue" name="valor" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bootstrap JS (v5.3.3) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const modalModificar = new bootstrap.Modal(document.getElementById('modalModificar'));

        const TIPOS_INPUT = { email: 'email', telefono: 'tel', username: 'text', password: 'password' };

        function abrirModalModificacion(campo, etiqueta) {
            document.getElementById('modalTitulo').innerText = `Modificar ${etiqueta}`;
            document.getElementById('labelInput').innerText = `Nuevo/a ${etiqueta}:`;
            document.getElementById('inputCampo').value = campo;

            const input = document.getElementById('inputValue');
            input.type = TIPOS_INPUT[campo] || 'text';
            input.value = '';
            input.minLength = campo === 'password' ? 8 : 0;

            modalModificar.show();
        }

        document.querySelectorAll('.auto-cerrar').forEach((alertaEl) => {
            setTimeout(() => bootstrap.Alert.getOrCreateInstance(alertaEl).close(), 4000);
        });
    </script>
</body>
</html>