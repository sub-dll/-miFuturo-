<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - Cuenta</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts: Port Lligat Slab -->
    <link href="https://fonts.googleapis.com/css2?family=Port+Lligat+Slab&display=swap" rel="stylesheet">
    <!-- Tu archivo CSS separado -->
    <link rel="stylesheet" href="/css/perfil.css">
</head>
<body>

    <!-- Contenedor para mensajes de éxito -->
    <div id="alert-container"></div>

    <div class="container-fluid p-0">
        <div class="row g-0">
            
            <!-- Sidebar / Barra Lateral -->
            <div class="col-md-3 col-lg-2 sidebar px-3">
                <div class="text-muted small mb-3 px-3">Cuenta</div>
                <div class="d-flex align-items-center px-3 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-person-circle text-secondary me-2" viewBox="0 0 16 16">
                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                    </svg>
                    <span class="fw-bold" style="color: #2d3748;">Don quijote</span>
                </div>
                <nav class="nav flex-column">
                    <a class="nav-link active" href="#">Cuenta</a>
                    <a class="nav-link" href="#">Preferencias</a>
                    <a class="nav-link" href="#">Notificaciones</a>
                    <a class="nav-link" href="#">General</a>
                </nav>
            </div>

            <!-- Área Principal -->
            <div class="col-md-9 col-lg-10 main-content">
                <div class="container-fluid max-width-container">
                    <h1 class="section-title">Cuenta</h1>
                    <p class="section-sub">Cambia configuracion de la cuenta de usuario</p>

                    <h5 class="fw-bold fs-6 mt-4">Datos de contacto</h5>
                    <hr class="custom-divider">

                    <!-- Correo Electrónico -->
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            <div class="fw-bold">Correo Electronico</div>
                            <small class="text-light opacity-75">En este correo llegaran notificaciones de mensajes</small>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="modify-btn" onclick="abrirModalModificacion('Correo Electrónico')">[ Modificar ]</button>
                        </div>
                    </div>

                    <!-- Número de teléfono -->
                    <div class="row align-items-center mb-5">
                        <div class="col-md-8">
                            <div class="fw-bold">Numero de telefono</div>
                            <small class="text-light opacity-75">Necesario para verificar la cuenta</small>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="modify-btn" onclick="abrirModalModificacion('Número de Teléfono')">[ Modificar ]</button>
                        </div>
                    </div>

                    <h5 class="fw-bold fs-6 mt-4">Cambiar nombre de usuario / contraseña</h5>
                    <hr class="custom-divider">

                    <!-- Nombre de usuario -->
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            <div class="fw-bold">Nombre de usuario</div>
                            <small class="text-light opacity-75">Este es el nombre que se visualizara en los foros</small>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="modify-btn" onclick="abrirModalModificacion('Nombre de Usuario')">[ Modificar ]</button>
                        </div>
                    </div>

                    <!-- Cambio de contraseña -->
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            <div class="fw-bold">Cambio de contraseña</div>
                            <small class="text-light opacity-75">Restablece la contraseña si no te acuerdas de ella</small>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="modify-btn" onclick="abrirModalModificacion('Contraseña')">[ Modificar ]</button>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <!-- Modal genérico de Bootstrap para la modificación -->
    <div class="modal fade" id="modalModificar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content text-dark" style="font-family: 'Port Lligat Slab', serif;">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitulo">Modificar dato</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formModificar">
                        <div class="mb-3">
                            <label for="inputValue" class="form-label" id="labelInput">Nuevo valor:</label>
                            <input type="text" class="form-control" id="inputValue" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="guardarCambios()">Guardar cambios</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Tu archivo JS separado -->
    <script src="/js/perfil.js"></script>
</body>
</html>