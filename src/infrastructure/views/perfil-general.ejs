<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - Cuenta</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Port+Lligat-Slab&display=swap" rel="stylesheet">
    
    <style>
        body {
            background-color: #64748b;
            min-height: 100vh;
            font-family: 'Port Lligat Slab', serif;
        }
        .modal-overlay {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(8px);
        }
        .modal-box {
            background-color: #78869b;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            max-width: 1000px;
            width: 90%;
            height: 80vh;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .content-area {
            color: #f8fafc;
        }
        a.nav-link {
            color: #ffffff !important;
        }
    </style>
</head>
<body class="m-0 text-white">

    <!-- Mensajes de alerta -->
    <div id="alert-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1060;">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
                <strong>Error:</strong> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof exito !== 'undefined' && exito) { %>
            <div class="alert alert-success alert-dismissible fade show shadow auto-cerrar" role="alert">
                <strong>¡Éxito!</strong> <%= exito %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    </div>

    <!-- NAVBAR GLOBAL -->
    <%- include('partials/navbar') %>

    <!-- CAPA OVERLAY FLOTANTE CENTRADA -->
    <div class="modal-overlay position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-3" style="top: 76px !important; height: calc(100vh - 76px) !important; z-index: 1040;">
        
        <div class="modal-box d-flex overflow-hidden">
            <div class="row g-0 w-100 h-100">
                
                <!-- Sidebar lateral -->
                <%- include('partials/sidebar-perfil', { active: 'cuenta' }) %>

                <!-- Área de Contenido -->
                <div class="col-md-9 col-lg-9 p-4 p-md-5 overflow-y-auto h-100 content-area">
                    
                    <div class="text-end mb-2">
                        <a href="/" class="btn-close btn-close-white" aria-label="Cerrar"></a>
                    </div>

                    <h1 class="fs-3 fw-bold mb-0">Cuenta</h1>
                    <p class="fs-6 text-light opacity-75 mb-3">Cambia configuración de la cuenta de usuario</p>

                    <h4 class="fw-bold mb-4 fs-5 text-white">Hola, <%= usuario.nombres || usuario.username || 'Usuario' %></h4>

                    <h5 class="fw-bold fs-6 mt-4 text-white">Datos de contacto</h5>
                    <hr class="border-white border-opacity-50 my-3">

                    <!-- Correo electrónico -->
                    <div class="mb-4">
                        <label class="fw-bold d-block">Correo Electrónico</label>
                        <small class="text-light opacity-75 d-block mb-2">En este correo llegarán notificaciones de mensajes</small>
                        <form action="/perfil/actualizar" method="POST" class="d-flex gap-2">
                            <input type="hidden" name="campo" value="email">
                            <input type="email" name="valor" class="form-control bg-white text-dark w-auto" value="<%= usuario.email || '' %>" required>
                            <button type="submit" class="btn btn-outline-light btn-sm">Modificar</button>
                        </form>
                    </div>

                    <!-- Número de teléfono -->
                    <div class="mb-4">
                        <label class="fw-bold d-block">Número de teléfono</label>
                        <small class="text-light opacity-75 d-block mb-2">Necesario para verificar la cuenta</small>
                        <form action="/perfil/actualizar" method="POST" class="d-flex gap-2">
                            <input type="hidden" name="campo" value="telefono">
                            <input type="text" name="valor" class="form-control bg-white text-dark w-auto" value="<%= usuario.telefono || '' %>">
                            <button type="submit" class="btn btn-outline-light btn-sm">Modificar</button>
                        </form>
                    </div>

                    <h5 class="fw-bold fs-6 mt-5 text-white">Cambiar nombre de usuario / contraseña</h5>
                    <hr class="border-white border-opacity-50 my-3">

                    <!-- Nombre de usuario -->
                    <div class="mb-4">
                        <label class="fw-bold d-block">Nombre de usuario</label>
                        <small class="text-light opacity-75 d-block mb-2">Este es el nombre que se visualizará en los foros</small>
                        <form action="/perfil/actualizar" method="POST" class="d-flex gap-2">
                            <input type="hidden" name="campo" value="username">
                            <input type="text" name="valor" class="form-control bg-white text-dark w-auto" value="<%= usuario.username || '' %>" required>
                            <button type="submit" class="btn btn-outline-light btn-sm">Modificar</button>
                        </form>
                    </div>

                    <!-- Cambio de contraseña -->
                    <div class="mb-4">
                        <label class="fw-bold d-block">Cambio de contraseña</label>
                        <small class="text-light opacity-75 d-block mb-2">Restablece la contraseña si no te acuerdas de ella</small>
                        <form action="/perfil/actualizar" method="POST" class="d-flex gap-2">
                            <input type="hidden" name="campo" value="password">
                            <input type="password" name="valor" class="form-control bg-white text-dark w-auto" placeholder="Nueva contraseña" required minlength="8">
                            <button type="submit" class="btn btn-outline-light btn-sm">Modificar</button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.auto-cerrar').forEach((alertaEl) => {
            setTimeout(() => bootstrap.Alert.getOrCreateInstance(alertaEl).close(), 4000);
        });
    </script>
</body>
</html>