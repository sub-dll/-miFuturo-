<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - Notificaciones</title>
    <!-- Importar Port Lligat Slab desde Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Port+Lligat+Slab&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #94a3b8;
            min-height: 100vh;
            font-family: 'Port Lligat Slab', serif;
        }
        .sidebar {
            background-color: #cbd5e1;
            min-height: 100vh;
            border-right: 1px solid #94a3b8;
        }
        .nav-link {
            color: #334155;
            font-weight: 500;
        }
        .nav-link.active {
            background-color: #94a3b8 !important;
            color: #0f172a !important;
            border-radius: 0.375rem;
        }
        .content-area {
            color: #f8fafc;
        }
        @media (max-width: 767.98px) {
            body.vh-100 {
                height: auto !important;
            }
            body.overflow-hidden {
                overflow: auto !important;
            }
            .container-fluid.h-100,
            .row.h-100,
            .content-area.h-100 {
                height: auto !important;
            }
            .sidebar {
                min-height: auto;
            }
            .content-area {
                overflow: visible !important;
                padding: 1rem !important;
            }
        }
        .form-check-input:checked {
            background-color: #3b82f6;
            border-color: #3b82f6;
        }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row">
            <!-- Menú Lateral -->
            <div class="col-md-3 col-lg-2 sidebar p-3">
                <div class="text-muted small mb-3">Cuenta</div>
                <div class="d-flex align-items-center px-2 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-person-circle text-secondary me-2" viewBox="0 0 16 16">
                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                    </svg>
                    <span class="fw-bold text-dark">Don quijote</span>
                </div>

                <nav class="nav flex-column">
                    <a class="nav-link rounded px-3 py-2 mb-1" href="/perfil">Cuenta</a>
                    <a class="nav-link rounded px-3 py-2 mb-1" href="/perfil/preferencias">Preferencias</a>
                    <a class="nav-link active rounded px-3 py-2 mb-1" href="/perfil/notificaciones">Notificaciones</a>
                    <a class="nav-link rounded px-3 py-2 mb-1" href="#">General</a>
                </nav>
            </div>

            <!-- Área de Contenido Principal -->
            <div class="col-md-9 col-lg-10 p-5 content-area">
                <h2 class="fw-bold text-white">Notificaciones</h2>
                <p class="text-light mb-4">Define cómo quieres las Notificaciones</p>

                <!-- Sección: Notificaciones -->
                <h5 class="text-white border-bottom pb-2 mb-4">Notificaciones</h5>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="mb-1 text-white">Comentarios</h6>
                        <small class="text-light">Recibe comentarios dentro del centro de notificaciones</small>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input fs-4" type="checkbox" role="switch" id="notifComentarios" <%= user && user.notifications && user.notifications.comentarios ? 'checked' : '' %>>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h6 class="mb-1 text-white">Menciones</h6>
                        <small class="text-light">Recibe menciones dentro del centro de notificaciones</small>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input fs-4" type="checkbox" role="switch" id="notifMenciones" <%= user && user.notifications && user.notifications.menciones ? 'checked' : '' %>>
                    </div>
                </div>

                <!-- Sección: Notificacion por correo electronico -->
                <h5 class="text-white border-bottom pb-2 mb-4">Notificacion por correo electronico</h5>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="mb-1 text-white">Enviar notificaciones por correo electronico</h6>
                        <small class="text-light">Elegir si activar el notificaciones a traves de correos</small>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input fs-4" type="checkbox" role="switch" id="notifEmail" <%= user && user.notifications && user.notifications.email ? 'checked' : '' %>>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>