<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - Preferencias</title>
    <!-- Bootstrap 5 CSS (v5.3.3) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Port+Lligat-Slab&display=swap" rel="stylesheet">
    
    <style>
        body {
            background-color: #64748b;
            min-height: 100vh;
            font-family: 'Port Lligat Slab', serif;
        }
        /* Capa overlay flotante con desenfoque */
        .modal-overlay {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(8px);
        }
        /* Tarjeta tipo Modal centrada */
        .modal-box {
            background-color: #78869b;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            max-width: 1000px;
            width: 90%;
            height: 80vh;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }
        .content-area {
            color: #f8fafc;
        }
        /* Barra de scroll delgada y oscura */
        .content-area::-webkit-scrollbar {
            width: 6px;
        }
        .content-area::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.25);
            border-radius: 4px;
        }
        a.nav-link {
            color: #ffffff !important;
        }
    </style>
</head>
<body class="m-0 text-white">

    <!-- Mensajes de alerta flotantes -->
    <div id="alert-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1060;">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
                <strong>Error:</strong> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof exito !== 'undefined' && exito) { %>
            <div class="alert alert-success alert-dismissible fade show shadow auto-cerrar" role="alert">
                <strong>¡Éxito!</strong> <%= exito %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    </div>

    <!-- 1. NAVBAR GLOBAL -->
    <%- include('partials/navbar') %>

    <!-- 2. CAPA OVERLAY FLOTANTE CENTRADA -->
    <div class="modal-overlay position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-3" style="top: 76px !important; height: calc(100vh - 76px) !important; z-index: 1040;">
        
        <!-- TARJETA DEL MODAL -->
        <div class="modal-box d-flex overflow-hidden">
            <div class="row g-0 w-100 h-100">
                
                <!-- Sidebar lateral -->
                <%- include('partials/sidebar-perfil', { active: 'preferencias' }) %>

                <!-- Área de Contenido -->
                <div class="col-md-9 col-lg-9 p-4 p-md-5 overflow-y-auto h-100 content-area">
                    
                    <!-- Botón X de cerrar ventana -->
                    <div class="text-end mb-2">
                        <a href="/" class="btn-close btn-close-white" aria-label="Cerrar"></a>
                    </div>

                    <h1 class="fs-3 fw-bold mb-0">Preferencias</h1>
                    <p class="fs-6 text-light opacity-75 mb-4">Elige cómo quieres ver [miFuturo] y establece sus preferencias</p>

                    <!-- Formulario de preferencias -->
                    <form id="form-preferencias">
                        
                        <h5 class="fw-bold fs-6 mt-4 text-white">Apariencia</h5>
                        <hr class="border-white border-opacity-50 my-3">

                        <!-- Temas -->
                        <div class="row align-items-center mb-4">
                            <div class="col-md-8">
                                <div class="fw-bold">Temas</div>
                                <small class="text-light opacity-75">Elige un tema para [miFuturo] en este dispositivo</small>
                            </div>
                            <div class="col-md-4 text-md-end mt-2 mt-md-0">
                                <select name="tema" class="btn btn-outline-light btn-sm d-inline-block w-auto text-start">
                                    <option value="oscuro" <%= typeof configuracion !== 'undefined' && configuracion && configuracion.tema === 'oscuro' ? 'selected' : '' %>>Oscuro</option>
                                    <option value="claro" <%= typeof configuracion !== 'undefined' && configuracion && configuracion.tema === 'claro' ? 'selected' : '' %>>Claro</option>
                                    <option value="sistema" <%= typeof configuracion !== 'undefined' && configuracion && configuracion.tema === 'sistema' ? 'selected' : '' %>>Predeterminado del sistema</option>
                                </select>
                            </div>
                        </div>

                        <!-- Contraste alto -->
                        <div class="row align-items-center mb-5">
                            <div class="col-md-8">
                                <div class="fw-bold">Contraste alto</div>
                                <small class="text-light opacity-75">Aumenta el contraste para mejorar la visibilidad</small>
                            </div>
                            <div class="col-md-4 text-md-end mt-2 mt-md-0">
                                <select name="contraste_alto" class="btn btn-outline-light btn-sm d-inline-block w-auto text-start">
                                    <option value="1" <%= typeof configuracion !== 'undefined' && configuracion && configuracion.contraste_alto == 1 ? 'selected' : '' %>>Activado</option>
                                    <option value="0" <%= typeof configuracion !== 'undefined' && configuracion && configuracion.contraste_alto == 0 ? 'selected' : '' %>>Desactivado</option>
                                </select>
                            </div>
                        </div>

                        <h5 class="fw-bold fs-6 mt-4 text-white">Idioma</h5>
                        <hr class="border-white border-opacity-50 my-3">

                        <!-- Idioma -->
                        <div class="row align-items-center mb-4">
                            <div class="col-md-8">
                                <div class="fw-bold">Idioma</div>
                                <small class="text-light opacity-75">Elige el idioma en el que quieres usar la plataforma</small>
                            </div>
                            <div class="col-md-4 text-md-end mt-2 mt-md-0">
                                <select id="select-idioma" name="idioma" class="btn btn-outline-light btn-sm d-inline-block w-auto text-start">
                                    <option value="es" <%= typeof configuracion !== 'undefined' && configuracion && configuracion.idioma === 'es' ? 'selected' : '' %>>Español</option>
                                    <option value="en" <%= typeof configuracion !== 'undefined' && configuracion && configuracion.idioma === 'en' ? 'selected' : '' %>>English</option>
                                </select>
                            </div>
                        </div>

                        <!-- Botón de guardar cambios -->
                        <div class="text-end my-4">
                            <button type="submit" class="btn btn-light px-4 fw-bold shadow-sm">Guardar Cambios</button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.auto-cerrar').forEach((alertaEl) => {
            setTimeout(() => bootstrap.Alert.getOrCreateInstance(alertaEl).close(), 4000);
        });

        document.addEventListener('DOMContentLoaded', () => {
            const formPreferencias = document.getElementById('form-preferencias');
            const selectIdioma = document.getElementById('select-idioma');

            // Función para enviar la petición a la base de datos
            async function guardarIdioma(idioma) {
                try {
                    const response = await fetch('/perfil/preferencias/idioma', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ idioma })
                    });

                    const data = await response.json();

                    if (data.ok) {
                        console.log('✅ Idioma guardado correctamente:', data.idioma);
                        mostrarAlertaExito('Idioma guardado correctamente');
                    } else {
                        console.error('❌ Error al guardar idioma:', data.error);
                    }
                } catch (error) {
                    console.error('❌ Error de red al intentar guardar el idioma:', error);
                }
            }

            // 1. Intercepta el evento de submit al pulsar "Guardar Cambios"
            if (formPreferencias) {
                formPreferencias.addEventListener('submit', (e) => {
                    e.preventDefault();
                    if (selectIdioma) {
                        guardarIdioma(selectIdioma.value);
                    }
                });
            }

            // 2. Guarda automáticamente al cambiar la opción del selector
            if (selectIdioma) {
                selectIdioma.addEventListener('change', (e) => {
                    guardarIdioma(e.target.value);
                });
            }
        });

        function mostrarAlertaExito(mensaje) {
            const container = document.getElementById('alert-container');
            if (!container) return;

            const alertHtml = `
                <div class="alert alert-success alert-dismissible fade show shadow auto-cerrar" role="alert">
                    <strong>¡Éxito!</strong> ${mensaje}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', alertHtml);

            const nuevaAlerta = container.lastElementChild;
            setTimeout(() => bootstrap.Alert.getOrCreateInstance(nuevaAlerta).close(), 4000);
        }
    </script>
</body>
</html>