<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar Contraseña - miFuturo</title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  
  <style>
    .bg-custom-blue { 
      background-color: #b8c8d9; 
    }

    .btn-custom-blue { 
      background-color: #8ba3c1; 
      color: #ffffff; 
    }

    .btn-custom-blue:hover { 
      background-color: #7a92af; 
      color: #ffffff; 
    }

    .link-custom {
      color: #6a88ab;
    }

    .link-custom:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body class="bg-white min-vh-100 d-flex align-items-center justify-content-center p-3">

  <!-- Marco Exterior -->
  <div class="w-100 vh-100 d-flex align-items-center justify-content-center p-2 p-md-4">
    
    <!-- Contenedor Azul-Grisáceo Principal -->
    <div class="bg-custom-blue w-100 h-100 rounded-5 d-flex align-items-center justify-content-center p-3">
      
      <!-- Tarjeta Blanca Central -->
      <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 text-center" style="max-width: 450px; width: 100%;">
        <h1 class="h3 fw-semibold text-dark mb-1">Recuperar contraseña</h1>
        <p class="text-muted small mb-4">Ingresa tu correo y tu nueva contraseña</p>

        <form onsubmit="event.preventDefault();">
          <!-- Campo Correo -->
          <div class="input-group mb-3">
            <input type="email" class="form-control form-control-lg bg-light border-0 rounded-start-3 fs-6" placeholder="Correo electrónico" required>
            <span class="input-group-text bg-light border-0 rounded-end-3 text-muted"><i class="fa-regular fa-envelope"></i></span>
          </div>

          <!-- Campo Nueva Contraseña -->
          <div class="input-group mb-3">
            <input type="password" class="form-control form-control-lg bg-light border-0 rounded-start-3 fs-6" placeholder="Nueva contraseña" required>
            <span class="input-group-text bg-light border-0 rounded-end-3 text-muted"><i class="fa-solid fa-lock"></i></span>
          </div>

          <!-- Campo Repetir Contraseña -->
          <div class="input-group mb-4">
            <input type="password" class="form-control form-control-lg bg-light border-0 rounded-start-3 fs-6" placeholder="Repetir nueva contraseña" required>
            <span class="input-group-text bg-light border-0 rounded-end-3 text-muted"><i class="fa-solid fa-lock"></i></span>
          </div>

          <!-- Botón de Envío -->
          <button type="submit" class="btn btn-custom-blue btn-lg w-100 rounded-3 fs-6 fw-medium d-flex align-items-center justify-content-center gap-2">
            Siguiente <i class="fa-solid fa-chevron-right small"></i>
          </button>
        </form>

        <div class="mt-4 small text-muted">
          ¿Recordaste tu contraseña? <a href="/login" class="text-decoration-none fw-medium link-custom">Iniciar sesión</a>
        </div>
      </div>

    </div>
  </div>

</body>
</html>