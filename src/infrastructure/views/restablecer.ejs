<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restablecer Contraseña - miFuturo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    .bg-custom-blue { background-color: #b8c8d9; }
    .btn-custom-blue { background-color: #8ba3c1; color: #ffffff; }
    .btn-custom-blue:hover { background-color: #7a92af; color: #ffffff; }
  </style>
</head>
<body class="bg-white min-vh-100 d-flex align-items-center justify-content-center p-3">
  <div class="bg-custom-blue w-100 rounded-5 d-flex align-items-center justify-content-center p-3" style="min-height: 90vh;">
    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 text-center" style="max-width: 450px; width: 100%;">
      <h1 class="h3 fw-semibold text-dark mb-1">Restablecer contraseña</h1>
      <p class="text-muted small mb-4">Crea una nueva contraseña para tu cuenta</p>

      <% if (error) { %>
        <div class="alert alert-danger small" role="alert"><%= error %></div>
      <% } %>

      <% if (token) { %>
        <form action="/restablecer" method="POST">
          <input type="hidden" name="token" value="<%= token %>">
          <div class="input-group mb-3">
            <input type="password" name="nuevaPassword" minlength="8" class="form-control bg-light border-0 fs-6" placeholder="Nueva contraseña" required>
            <span class="input-group-text bg-light border-0 text-muted"><i class="fa-solid fa-lock"></i></span>
          </div>
          <div class="input-group mb-4">
            <input type="password" name="confirmarPassword" minlength="8" class="form-control bg-light border-0 fs-6" placeholder="Confirmar contraseña" required>
            <span class="input-group-text bg-light border-0 text-muted"><i class="fa-solid fa-lock"></i></span>
          </div>
          <button type="submit" class="btn btn-custom-blue btn-lg w-100 rounded-3 fs-6 fw-medium">
            Cambiar contraseña
          </button>
        </form>
      <% } else { %>
        <a href="/recuperar" class="btn btn-custom-blue w-100">Solicitar un enlace nuevo</a>
      <% } %>
    </div>
  </div>
</body>
</html>
