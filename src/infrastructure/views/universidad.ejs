<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= universidad.nombre %> - miFuturo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/global.css" rel="stylesheet">
</head>
<body class="bg-light">
    
    <%- include('partials/navbar') %>

    <main class="container py-5" style="max-width: 1100px;">
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-4 shadow-sm">← Volver al inicio</a>

        <!-- Banner Superior de la Universidad -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background-color: #8C9FBA; color: white;">
            <div class="d-flex align-items-center gap-4">
                <% if (universidad.logo_url) { %>
                    <img src="<%= universidad.logo_url %>" alt="Logo <%= universidad.nombre %>" class="rounded-circle bg-white border p-1" style="width: 100px; height: 100px; object-fit: cover;">
                <% } %>
                <div>
                    <h1 class="fw-bold mb-1"><%= universidad.nombre %></h1>
                    <div class="d-flex gap-3 mt-2">
                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill shadow-sm"><%= universidad.ciudad %></span>
                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill shadow-sm"><%= universidad.años_acreditacion ? universidad.años_acreditacion + ' Años de Acreditación' : 'Acreditación no especificada' %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: Descripción institucional -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h5 class="fw-bold mb-3 text-dark">Sobre la Institución</h5>
                    <p class="small text-muted text-justify mb-4" style="line-height: 1.6;">
                        <%= universidad.descripcion || 'No hay descripción disponible para esta institución en este momento.' %>
                    </p>
                    
                    <% if (universidad.sitio_web) { %>
                        <div class="text-center mt-auto">
                            <a href="<%= universidad.sitio_web %>" target="_blank" class="btn btn-outline-secondary rounded-pill px-4 w-100">Visitar Sitio Web</a>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- COLUMNA DERECHA: Lista de Carreras -->
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0 text-dark">Programas Académicos</h4>
                    <span class="text-muted small"><%= programas.length %> programas disponibles</span>
                </div>

                <% if (programas.length > 0) { %>
                    <div class="d-flex flex-column gap-3">
                        <% programas.forEach(programa => { %>
                            <div class="card border-0 shadow-sm rounded-4 hover-card p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="pe-3">
                                        <h5 class="fw-bold mb-1 text-dark"><%= programa.nombre_carrera %></h5>
                                        <p class="small text-muted mb-0 text-truncate" style="max-width: 450px;">
                                            <%= programa.descripcion_general || 'Conoce más detalles sobre este programa académico.' %>
                                        </p>
                                    </div>
                                    
                                    <!-- BOTÓN CLAVE: Este lleva a perfil-carrera.ejs (Flujo 1) -->
                                    <a href="/programa/<%= programa.id_programa %>" class="btn btn-sm rounded-pill px-4 text-white flex-shrink-0" style="background-color: #2c3e50;">
                                        Ver Detalles
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="alert alert-secondary border-0 rounded-4 text-center">
                        Actualmente no hay carreras registradas para esta universidad.
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>