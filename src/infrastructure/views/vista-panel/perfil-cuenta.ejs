<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - Cuenta</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts: Port Lligat Slab -->
    <link href="https://fonts.googleapis.com/css2?family=Port+Lligat+Slab&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #94a3b8;
            min-height: 100vh;
            font-family: 'Port Lligat Slab', serif;
        }
        .sidebar {
            background-color: #cbd5e1;
            min-height: 100vh;
            border-right: 1px solid #94a3b8;
        }
        .nav-link {
            color: #334155;
            font-weight: 500;
        }
        .nav-link.active {
            background-color: #94a3b8;
            color: #0f172a;
            border-radius: 0.375rem;
        }
        .content-area {
            color: #f8fafc;
        }
        .valor-actual {
            color: #0f172a;
            background-color: rgba(255, 255, 255, 0.55);
            border-radius: 0.375rem;
            padding: 0.1rem 0.5rem;
            display: inline-block;
            margin-top: 0.25rem;
        }
        @media (max-width: 767.98px) {
            body.vh-100 {
                height: auto !important;
            }
            body.overflow-hidden {
                overflow: auto !important;
            }
            .container-fluid.h-100,
            .row.h-100,
            .content-area.h-100 {
                height: auto !important;
            }
            .sidebar {
                min-height: auto;
            }
            .content-area {
                overflow: visible !important;
                padding: 1rem !important;
            }
        }
    </style>
</head>
<body class="vh-100 overflow-hidden m-0 text-white">

    <!-- Mensajes del servidor (éxito / error) -->
    <div id="alert-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
                <strong>Error:</strong> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof exito !== 'undefined' && exito) { %>
            <div class="alert alert-success alert-dismissible fade show shadow auto-cerrar" role="alert">
                <strong>¡Éxito!</strong> <%= exito %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    </div>

    <div class="container-fluid p-0 h-100">
        <div class="row g-0 h-100">
            <%- include('../partials/navbar', { active: 'cuenta' }) %>

            <!-- Área Principal con scroll -->
            <div class="col-md-9 col-lg-10 p-5 overflow-y-auto h-100 content-area">
                <div class="container-fluid">
                    <h1 class="fs-3 fw-bold mb-0">Cuenta</h1>
                    <p class="fs-6 text-light opacity-75 mb-1">Cambia configuracion de la cuenta de usuario</p>
                    <p class="fs-5 mb-4" id="saludo-usuario">
                        Hola, <strong><%= usuario.nombres %><%= usuario.apellidos ? ' ' + usuario.apellidos : '' %></strong>
                    </p>

                    <h5 class="fw-bold fs-6 mt-4">Datos de contacto</h5>
                    <hr class="border-white border-opacity-50 my-3">

                    <!-- Correo Electrónico -->
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            <div class="fw-bold">Correo Electronico</div>
                            <small class="text-light opacity-75">En este correo llegaran notificaciones de mensajes</small><br>
                            <span class="valor-actual" id="valor-email"><%= usuario.email %></span>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="btn btn-outline-light btn-sm" onclick="abrirModalModificacion('email', 'Correo Electrónico')">Modificar</button>
                        </div>
                    </div>

                    <!-- Número de teléfono -->
                    <div class="row align-items-center mb-5">
                        <div class="col-md-8">
                            <div class="fw-bold">Numero de telefono</div>
                            <small class="text-light opacity-75">Necesario para verificar la cuenta</small><br>
                            <span class="valor-actual" id="valor-telefono"><%= usuario.telefono || 'Sin teléfono registrado' %></span>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="btn btn-outline-light btn-sm" onclick="abrirModalModificacion('telefono', 'Número de Teléfono')">Modificar</button>
                        </div>
                    </div>

                    <h5 class="fw-bold fs-6 mt-4">Cambiar nombre de usuario / contraseña</h5>
                    <hr class="border-white border-opacity-50 my-3">

                    <!-- Nombre de usuario -->
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            <div class="fw-bold">Nombre de usuario</div>
                            <small class="text-light opacity-75">Este es el nombre que se visualizara en los foros</small><br>
                            <span class="valor-actual" id="valor-username"><%= usuario.username || 'Sin nombre de usuario' %></span>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="btn btn-outline-light btn-sm" onclick="abrirModalModificacion('username', 'Nombre de Usuario')">Modificar</button>
                        </div>
                    </div>

                    <!-- Cambio de contraseña -->
                    <div class="row align-items-center mb-3">
                        <div class="col-md-8">
                            <div class="fw-bold">Cambio de contraseña</div>
                            <small class="text-light opacity-75">Restablece la contraseña si no te acuerdas de ella</small>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <button class="btn btn-outline-light btn-sm" onclick="abrirModalModificacion('password', 'Contraseña')">Modificar</button>
                        </div>
                    </div>

                </div>
                <%- include('../partials/footer') %>
            </div>

        </div>
    </div>

    <!-- Modal de Bootstrap: ahora es un formulario real que hace POST al backend -->
    <div class="modal fade" id="modalModificar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form class="modal-content text-dark" id="formModificar" method="POST" action="/perfil/actualizar" style="font-family: 'Port Lligat Slab', serif;">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitulo">Modificar dato</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="campo" id="inputCampo">
                    <div class="mb-3">
                        <label for="inputValue" class="form-label" id="labelInput">Nuevo valor:</label>
                        <input type="text" class="form-control" id="inputValue" name="valor" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bootstrap JS (necesario para el modal y las alertas) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const modalModificar = new bootstrap.Modal(document.getElementById('modalModificar'));

        const TIPOS_INPUT = { email: 'email', telefono: 'tel', username: 'text', password: 'password' };

        function abrirModalModificacion(campo, etiqueta) {
            document.getElementById('modalTitulo').innerText = `Modificar ${etiqueta}`;
            document.getElementById('labelInput').innerText = `Nuevo/a ${etiqueta}:`;
            document.getElementById('inputCampo').value = campo;

            const input = document.getElementById('inputValue');
            input.type = TIPOS_INPUT[campo] || 'text';
            input.value = '';
            input.minLength = campo === 'password' ? 8 : 0;

            modalModificar.show();
        }

        // Las alertas de éxito se cierran solas después de 4 segundos
        document.querySelectorAll('.auto-cerrar').forEach((alertaEl) => {
            setTimeout(() => bootstrap.Alert.getOrCreateInstance(alertaEl).close(), 4000);
        });
    </script>
</body>
</html>
